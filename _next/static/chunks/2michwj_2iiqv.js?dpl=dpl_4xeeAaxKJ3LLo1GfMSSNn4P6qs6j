ort((e,t)=>e.day-t.day)}function A(e){return C(e).filter(e=>e.topPick)}e.s(["HOLIDAYS_YEAR",0,2026,"MONTH_LABELS",0,I,"MONTH_SLUG_PARTS",0,j,"SOCIAL_MEDIA_HOLIDAYS",0,P,"holidaysForMonth",0,C,"monthLabel",0,L,"topPicksForMonth",0,A],678259);let D="2026-08-03",M="social-media-holidays",E=j.map(e=>`social-media-holidays-${e}`);function F(e){return E[e-1]??M}let q=P.filter(e=>e.topPick).length;function R(e){return e.length<=1?e[0]??"":`${e.slice(0,-1).join(", ")} and ${e[e.length-1]}`}function B(e){return`${e.name} on ${L(e.month)} ${e.day}`}let O={1:{heroLead:"January opens on New Year's Day, hands you Martin Luther King Jr. Day on January 19 and closes with Data Privacy Day on January 28. Here is the whole month with dates, hashtags and an honest note on which ones are worth posting for.",metaDescription:"Social media holidays in January: New Year's Day, Martin Luther King Jr. Day on January 19, Data Privacy Day on January 28 and more, with hashtags and dates.",intro:["January is the one month of the year when nobody has to be talked into making a plan. New Year's Day on January 1 arrives with an audience that is already thinking in resolutions, fresh starts and what they want the next twelve months to look like, which is a rare gift: you get to talk about improvement without having to manufacture the reason. The catch is that everyone else noticed too, so the first week of the month is the most crowded week of the quarter, and a generic new year post lands in a feed of identical generic new year posts.","The rest of January is far less contested and often far more useful. Martin Luther King Jr. Day on January 19 is a day for reflection and service, not for a discount code, and brands that treat it as a sales moment reliably regret it. Data Privacy Day on January 28 is one of the few dates on the whole calendar that a B2B or software account can own outright, because almost nobody else is posting and the subject genuinely matters to the people who follow you. Between them sit the light ones, from Houseplant Appreciation Day on January 10 to National Puzzle Day on January 29, which exist to give a brand voice somewhere to go on a slow Tuesday."],tips:["Post your new year message on January 2 or 3 rather than January 1. The feed on the first is wall to wall resolutions, and a post that lands two days later, when people are actually back at a desk, gets read instead of scrolled past.","Resolution content has a shelf life of about three weeks. Plan the encouraging follow up for the back half of the month, when the first wave of goals has quietly collapsed and a post that acknowledges that is worth more than another motivational quote.","Treat Martin Luther King Jr. Day on January 19 as a day to be quiet or to be substantive, and nothing in between. If you have real work or a real donation to point at, say so plainly. If you do not, a logo on a graphic is worse than posting nothing.","Data Privacy Day on January 28 is the easiest expert post a software or services account will get all quarter. Explain one thing you do with customer data in plain language, and you will out-perform the graphic everyone else publishes.","Use January to build February. Valentine's Day content needs product photography, shipping cutoffs and a landing page, and all three are pleasant in mid-January and miserable on February 10."],extraFaq:{question:"Is Martin Luther King Jr. Day always on January 19?",answer:"No. It is the third Monday of January, so the date moves every year, and the third Monday falls on January 19 in 2026. The table flags it as a floating date for that reason. New Year's Day on January 1 and Data Privacy Day on January 28 are fixed and can be planned years ahead."}},2:{heroLead:"February squeezes Super Bowl Sunday on February 8, Valentine's Day on February 14 and Lunar New Year on February 17 into a single three week run. Here is the whole month with dates, hashtags and the ones worth clearing your calendar for.",metaDescription:"Social media holidays in February: Super Bowl Sunday on February 8, Valentine's Day on February 14, Lunar New Year on February 17 and more, with hashtags.",intro:["February is short and unusually dense. Super Bowl Sunday on February 8 pulls an enormous live audience for one evening, Valentine's Day on February 14 is the second biggest gifting moment of the year for anything you can wrap, and Lunar New Year on February 17 opens a fifteen day celebration that matters to a large part of the world and gets ignored by most Western brands. Three genuinely large moments inside ten days is more concentration than any other month on this calendar has to offer.","It is also the month where the legal and tonal traps are thickest. The Super Bowl name is a registered trademark and unlicensed commercial use of it is a real risk, which is why so many brands say the big game instead. Valentine's Day is a painful day for a chunk of any mailing list, so the accounts that handle it best offer an obvious way out. And Lunar New Year is a specific cultural celebration with its own zodiac year and its own customs, not a generic red and gold background. Galentine's Day on February 13 sits there for anyone whose audience is not shopping for a partner, and Rare Disease Day closes the month on February 28."],tips:['Say "the big game" unless you have paid for the rights. Super Bowl is a registered trademark, and using it to promote a product is the kind of thing that generates a letter. The audience knows exactly what you mean either way.',"Set your Valentine's Day shipping cutoff and publish it. Anything physical needs to be ordered days ahead of February 14, and the post that saves the sale is the one that says so, not the one that says buy now on February 13.","Offer a Valentine's opt-out on your email list. A single line letting people skip the campaign costs you nothing and keeps the subscribers who would otherwise unsubscribe in the second week of February.","Galentine's Day on February 13 carries the accounts that Valentine's Day does not fit. Friendship, teams and communities are an easier story than romance for most brands, and the day before is far less crowded than the day itself.","Research before you post for Lunar New Year on February 17. It is a specific celebration with a zodiac animal and real customs attached, and a post that gets the year wrong is more visible than no post at all."],extraFaq:{question:"When is Lunar New Year in 2026, and can I just reuse last year's post?",answer:"Lunar New Year falls on February 17 in 2026 and it moves every year, because it follows a lunisolar calendar rather than the Gregorian one. Reusing an old post is also a bad idea for a second reason: each year carries a different zodiac animal, so last year's artwork is visibly wrong. The table flags it as a floating date along with Super Bowl Sunday on February 8 and Rare Disease Day on February 28."}},3:{heroLead:"March is the busiest month on the whole calendar: International Women's Day on March 8, Pi Day on March 14, St. Patrick's Day on March 17 and National Puppy Day on March 23. Here is the full month with dates and hashtags.",metaDescription:"Social media holidays in March: International Women's Day on March 8, Pi Day on March 14, St. Patrick's Day on March 17, National Puppy Day and more.",intro:["March carries more observances than any other month in this calendar, and it carries the widest spread of tone with them. International Women's Day on March 8 is a serious date with a serious audience for anyone who has something concrete to point at, and a well documented trap for anyone who does not. Pi Day on March 14 is a pure pun that works for bakeries, engineers, data teams and anybody willing to publish a photo of a pie. St. Patrick's Day on March 17 is the biggest hospitality day of the first quarter. National Puppy Day on March 23 is the reliable engagement day at the end of the month.","That range is what makes March worth planning rather than improvising. The same account can be substantive on the 8th, silly on the 14th, commercial on the 17th and warm on the 23rd, and the mix reads as personality rather than whiplash because the dates are far enough apart. The First Day of Spring on March 20 is the natural pivot point if you want your feed, your banner or your product photography to change season, and World Backup Day closes the month on March 31 for anyone in software."],tips:["International Women's Day on March 8 needs a fact, not a graphic. Name the thing you actually did, the person you are actually promoting or the organization you actually funded. Every year the accounts that post a purple logo and nothing else get asked about their pay gap in the replies.","Pi Day on March 14 is the lowest effort win of the quarter for anything numeric or edible. If you are neither, the joke still works at 1:59pm, which is the next three digits of pi.","St. Patrick's Day on March 17 belongs to food, drink and hospitality, and it is a stretch for most other categories. If green is not already in your brand, sitting this one out costs you nothing.","National Puppy Day on March 23 is the safest engagement post in the month. An office dog, a customer's dog or a founder's dog will out-perform your product photography, which is annoying but has been true for a decade.","Use the First Day of Spring on March 20 as your seasonal reset. Swap the header image, refresh the pinned post and update the product shots in one sitting rather than drifting into April with winter photography."],extraFaq:{question:"March has more observances than any other month. Should I post more in March?",answer:`No. A busier month is a fuller menu, not a bigger quota. March lists ${C(3).length} observances and flags ${A(3).length} as top picks, and two or three well made posts across the month will beat ${C(3).length} rushed ones every time. Pick the dates your audience would recognize and let the rest pass.`}},4:{heroLead:"April opens with April Fools' Day on April 1, resolves Easter Sunday to April 5 and builds to Earth Day on April 22. Here is the full month with dates, hashtags and where the risk sits.",metaDescription:"Social media holidays in April: April Fools' Day on April 1, Easter Sunday on April 5, Earth Day on April 22 and more, with hashtags and floating dates noted.",intro:["April is the month with the highest ratio of upside to downside, in both directions. April Fools' Day on April 1 has produced some of the best brand posts ever published and a much longer list of fake product announcements that confused customers, got picked up as real news and had to be walked back by lunchtime. Earth Day on April 22 is the same shape: an enormous, genuinely engaged audience for anyone with a real environmental story, and a fast route to being accused of greenwashing by anyone without one.","Easter Sunday sits between them on April 5, and it is the floating date most likely to catch a planner out, because it moves across a five week window and does not even stay in the same month from year to year. Around those three, April is unusually friendly to ordinary content: National Pet Day on April 11, World Book Day on April 23 and International Dance Day on April 29 all ask for nothing more than a photo and a sentence, and Tax Day in the US on April 15 gives finance and accounting accounts their single best hook of the year."],tips:["If your April Fools' idea requires a correction the next day, it is not a joke, it is a support ticket. The safe version is a product that obviously cannot exist. The dangerous version is a plausible announcement.","Sitting out April Fools' Day on April 1 is a completely respectable choice, and it is the right one for anything in health, finance or safety, where a joke about your own product undermines the trust you spend the rest of the year building.","Check the Easter date every year before you reuse anything. Easter Sunday lands on April 5 this year, but the Western date can fall anywhere from late March to late April, so a recycled campaign will be days out.","Earth Day on April 22 rewards a number and punishes an adjective. Post the actual quantity you cut, the actual supplier you changed or the actual program you fund. If the honest answer is that you have not done anything yet, say what you are doing next.","Tax Day in the US on April 15 is the one date finance, bookkeeping and accounting accounts should build a real campaign around. The search intent is enormous and it disappears completely on April 16."],extraFaq:{question:"Does Easter always fall in April?",answer:"No. Western Easter Sunday can land anywhere between late March and late April depending on the paschal full moon, and Orthodox Easter often falls on a different date again. This calendar resolves the Western date to April 5 in 2026 and flags it as a floating entry, which is your cue to re-check it rather than reuse it. April Fools' Day on April 1 and Earth Day on April 22 are fixed."}},5:{heroLead:"May runs from Star Wars Day on May 4 through Mother's Day on May 10 to Memorial Day on May 25. Here is the full month with dates, hashtags and notes on the two that move every year.",metaDescription:"Social media holidays in May: Star Wars Day on May 4, Mother's Day on May 10, Memorial Day on May 25 and more, with hashtags and floating dates resolved.",intro:["May is the month where tone matters most, because its three biggest dates ask for three completely different voices inside four weeks. Star Wars Day on May 4 is a pun the whole internet is in on and the single easiest post of the quarter. Mother's Day in the US on May 10 is a large commercial moment and, for a meaningful slice of any audience, a genuinely painful day. Memorial Day in the US on May 25 is a remembrance, and the brands that treat it as the unofficial start of summer with a sale attached are the ones that end up apologizing.","Both of the big ones float. Mother's Day is the second Sunday of May and Memorial Day is the last Monday, so neither repeats on the same date, and a campaign copied forward from last year will be off by days. Underneath them May is comfortable: Cinco de Mayo on May 5, National Nurses Day on May 6, International Day of Families on May 15 and World Bee Day on May 20 are all straightforward posts, and National Hamburger Day on May 28 gives food accounts a soft landing into the long weekend."],tips:["Give people a way out of your Mother's Day campaign. One line at the top of the email offering to skip it is now standard practice for a reason: it saves subscribers you would otherwise lose in the first week of May.","Memorial Day on May 25 is a remembrance, not a sale. If your business genuinely runs a long weekend promotion, keep the promotion and the remembrance in separate posts, and never combine the two in one graphic.","Star Wars Day on May 4 works for any brand with a sense of humor, but the pun is what is free, not the property. Do not use the logos, the characters or the artwork unless you hold a license.","Remember that Mother's Day is not a global date. The UK celebrates Mothering Sunday in March, and dozens of countries use other dates entirely, so a worldwide audience needs a targeted send rather than one blast on May 10.","Nurses and healthcare accounts should plan the first week of May properly. National Nurses Day on May 6 and International Nurses Day on May 12 sit close enough together to run as one campaign rather than two disconnected posts."],extraFaq:{question:"Are Mother's Day and Memorial Day on the same dates every year?",answer:"Neither one is. Mother's Day in the US is the second Sunday of May, which is May 10 in 2026, and Memorial Day is the last Monday of May, which is May 25. Both carry a floating note in the table for that reason. Star Wars Day on May 4 and Cinco de Mayo on May 5 are fixed and never move."}},6:{heroLead:"June covers World Environment Day on June 5, Juneteenth on June 19, Father's Day on June 21 and Social Media Day on June 30. Here is the full month with dates, hashtags and which ones move.",metaDescription:"Social media holidays in June: World Environment Day on June 5, Juneteenth on June 19, Father's Day on June 21, Social Media Day on June 30 and more.",intro:["June is the month most accounts underestimate. World Environment Day on June 5 opens it, Juneteenth on June 19 is a US federal holiday with a specific history that deserves care rather than a sale, Father's Day in the US falls on June 21, and Social Media Day on June 30 closes the month with the one observance that is genuinely about the work most people reading this do for a living. That is four distinct audiences in four weeks, and only one of them is commercial.","It is also a good month for the softer, lower stakes posts that keep a feed human. National Doughnut Day on June 5, Take Your Dog to Work Day on June 26 and International Day of Yoga on June 21 all ask for a photo and a caption rather than a campaign, and World Oceans Day on June 8 gives anyone with a sustainability story a second, less crowded slot than Earth Day in April. Father's Day and the two Friday-based observances all move from year to year, which is worth checking before you copy anything forward."],tips:["Juneteenth on June 19 is a commemoration of emancipation, not a retail moment. Amplify Black-owned businesses, creators or organizations, or say nothing. A themed discount code is the version that goes wrong in public every single year.","Give Father's Day on June 21 the same opt-out you gave Mother's Day in May. The reasons a subscriber wants to skip the campaign are exactly the same, and so is the goodwill you keep by offering it.","Social Media Day on June 30 is the one date on this calendar written for agencies, managers and creators. A behind the scenes look at how you actually plan a month will out-perform anything you post about your product.","Take Your Dog to Work Day on June 26 is the easiest team content of the summer, and it floats: it is the Friday after Father's Day, so check the date before you schedule it.","Use the second half of June to bank your July and August content. The summer months are quiet on observances and heavy on time off, which makes them the ideal weeks to run on a queue you filled in advance."],extraFaq:{question:"What is Social Media Day, and is it worth posting for?",answer:"Social Media Day is June 30, and it started as a celebration of how social platforms connect people. It is worth posting for if your audience is made up of marketers, creators or business owners, because it is one of the few dates where talking about how you use social media is on topic rather than navel gazing. If your audience is retail customers, it means nothing to them, and Father's Day on June 21 or World Environment Day on June 5 will do more for you."}},7:{heroLead:"July gives you Independence Day in the US on July 4, World Chocolate Day on July 7 and World Emoji Day on July 17, and every date in the month is fixed. Here is the full list with hashtags.",metaDescription:"Social media holidays in July: Independence Day on July 4, World Chocolate Day on July 7, World Emoji Day on July 17 and more, with hashtags and fixed dates.",intro:["July is a quiet month with three loud days in it. Independence Day in the US on July 4 dominates the first week for American audiences and means nothing at all to the rest of the world, which is worth remembering before you schedule one post for everybody. World Chocolate Day on July 7 is the food day with the widest reach of the summer, and World Emoji Day on July 17 is the rare observance that any account can post for, because every brand on earth already communicates in emoji whether it admits it or not.","The rest of the month is deliberately light, which is exactly what you want in the middle of the summer. National French Fry Day on July 13, International Chess Day on July 20 and National Avocado Day on July 31 are single photo posts, International Self-Care Day on July 24 suits wellness accounts, and International Day of Friendship on July 30 works for any community driven feed. Canada Day on July 1 opens the month for Canadian audiences three days before the American one."],tips:["Do not blanket-post Independence Day on July 4 to a global audience. It is a national holiday, not a worldwide one, and a fireworks graphic sent to subscribers in twelve countries reads as carelessness rather than celebration.","World Emoji Day on July 17 is the most flexible date in the month. A post about the emoji you overuse, the one your team argues about or the one that means something different to your customers works for literally any category.","Food days carry July. World Chocolate Day on July 7 and National French Fry Day on July 13 are the two with real search volume behind them, and both work with a single well lit photo and no production budget.","Batch and schedule before you take time off. July is the month when someone is always away, and a queue filled in June is the difference between a feed that keeps running and one that goes silent for three weeks.","Use the quiet weeks for the posts that never get made. The evergreen explainer, the customer story, the FAQ video: July has the fewest competing dates of the second half of the year, so an ordinary post gets an unusually good share of attention."],extraFaq:{question:"Why is World Emoji Day on July 17?",answer:"Because that is the date shown on the calendar emoji itself, which is where the observance came from. It has been marked on July 17 every year since it was created, and unlike a lot of the newer hashtag days it now gets picked up by the platforms themselves. Every July entry in this calendar sits on a fixed date, so July 17 and World Chocolate Day on July 7 will be the same days next year and the year after."}},8:{heroLead:"August is carried by International Cat Day on August 8, World Photography Day on August 19 and National Dog Day on August 26, and every date in the month is fixed. Here is the full list with hashtags.",metaDescription:"Social media holidays in August: International Cat Day on August 8, World Photography Day on August 19, National Dog Day on August 26 and more, with hashtags.",intro:["August is the lightest month on the calendar and the one where the stakes are lowest, which makes it the best month of the year to have some fun. International Cat Day on August 8 and National Dog Day on August 26 are the two highest engagement posts most accounts will publish all summer, and neither of them requires you to sell anything. World Photography Day on August 19 sits between them and is an open invitation to show the work: the archive, the outtakes, the shot you were proud of and never used.","Nothing in August floats, so the whole month can be planned once and reused for years. Around the big three, World Wide Web Day on August 1, National Lazy Day on August 10, International Lefthanders Day on August 13, National Relaxation Day on August 15 and National Beach Day on August 30 are all one photo and one line. Use the spare capacity for something that matters more: the fourth quarter is closer than it feels, and the accounts that survive November are the ones that started building it in August."],tips:["Pet days are not a cop-out. International Cat Day on August 8 and National Dog Day on August 26 consistently out-perform product posts on reach and replies, and an animal that belongs to your team or a customer is more on brand than a stock photo of anything.","World Photography Day on August 19 is a free excuse to show your process. Post the shots you rejected next to the one you shipped, or the setup behind a photo people already liked. Behind the scenes content performs and almost nobody plans it.","Every August date is fixed, so build the month once and keep it. This is the single easiest month to templatize, and doing it now buys you a free week next August.","Start your fourth quarter assets in August. Black Friday creative made in November is made in a panic, and the four commercial days at the end of that month are worth more than everything you will post between now and then.","Keep the cadence up even though your audience is away. Reach dips in August because everyone posts less, which means the accounts that keep going take a larger share of a smaller feed. Coming back in September from a silent month is much harder than never stopping."],extraFaq:{question:"Why are there two cat days on this calendar?",answer:"Because they are two different observances. International Cat Day is August 8 and is marked worldwide, while National Cat Day in the US falls on October 29 and is a separate American observance. If your audience is global, August 8 is the one to use. If it is US-first, you can post for either, but posting for both looks like you are scraping a list rather than picking dates."}},9:{heroLead:"September runs from Labor Day in the US on September 7 through the International Day of Peace on September 21 to National Coffee Day on September 29. Here is the full month with dates and hashtags.",metaDescription:"Social media holidays in September: Labor Day on September 7, International Day of Peace on September 21, National Coffee Day on September 29 and more.",intro:["September is the month everybody comes back. Labor Day in the US on September 7 marks the end of the summer slowdown for American audiences, the International Day of Peace on September 21 is a serious global observance, and National Coffee Day on September 29 is one of the biggest freebie days in the calendar for anyone who serves a drink. Between them the month fills up with the sort of dates that suit a working audience: International Literacy Day on September 8, International Day of Democracy on September 15 and World Tourism Day on September 27.","It is also the month to be careful with dates that look fixed and are not. Labor Day is the first Monday, National Grandparents Day in the US follows Labor Day and lands on September 13, and the First Day of Autumn on September 22 depends on the equinox, so all three move. World Suicide Prevention Day on September 10 is the date on this month that most needs care rather than reach: post it with real resources or leave it to the organizations that do this work properly. International Talk Like a Pirate Day on September 19 is there when you need the opposite of all that."],tips:["Do not build a global campaign on Labor Day. It is a US date on September 7, most of the world marks a workers' holiday on May 1 instead, and the mismatch is obvious to anyone outside North America.","National Coffee Day on September 29 is the biggest small business day of the month. Cafes, roasters and anyone with a loyalty program should have an offer ready, because the search volume that day is enormous and it is gone by the 30th.","Handle World Suicide Prevention Day on September 10 properly or not at all. If you post, include a real helpline for your audience region and do not attach it to anything promotional. This is the clearest example on the calendar of a date where reach is the wrong goal.","Use the First Day of Autumn on September 22 as your seasonal refresh, the same way you used the first day of spring in March. Header, pinned post and product photography in one sitting.","September is your last comfortable planning window before the fourth quarter. Whatever you want ready for late November has to be briefed now, because October fills up faster than anyone expects."],extraFaq:{question:"Is Labor Day on the same date every year?",answer:"No. Labor Day in the US is the first Monday of September, which puts it on September 7 in 2026, and it carries a floating note in the table for that reason. National Grandparents Day and the First Day of Autumn move too. National Coffee Day on September 29 and the International Day of Peace on September 21 are fixed."}},10:{heroLead:"October is World Mental Health Day on October 10, National Cat Day in the US on October 29 and Halloween on October 31, with the fourth quarter starting to bite. Here is the full month with dates and hashtags.",metaDescription:"Social media holidays in October: World Mental Health Day on October 10, National Cat Day on October 29, Halloween on October 31 and more, with hashtags.",intro:["October belongs to Halloween on October 31, and pretending otherwise wastes a month. The costume, decoration and party content starts building weeks before the day itself, which means the accounts that post their first pumpkin on the 31st have already missed most of the audience. World Mental Health Day on October 10 is the serious counterweight, and it is a date where a graphic with a nice quote is much worse than either a real resource or silence. National Cat Day in the US on October 29 lands two days before Halloween and is the easy engagement post that carries the last week.","Underneath those three, October is a genuinely useful month for food and community accounts. International Coffee Day on October 1, National Noodle Day on October 6, National Dessert Day on October 14, World Food Day on October 16 and National Pumpkin Day on October 26 give you a steady run of single photo posts, and World Smile Day on October 2 floats with the first Friday of the month. Whatever else you do, October is also when your fourth quarter commercial assets have to be finished, because November arrives with four trading days in a row and no time to make anything."],tips:["Start Halloween content in the middle of October, not on the day. The audience is looking for costume, decoration and recipe ideas from about the 15th, and a post on October 31 arrives after every decision has already been made.","World Mental Health Day on October 10 is not a marketing opportunity. If you post, point at a real service, a real policy or a real thing you fund. Never run a promotion against it and never pair it with a product launch.","National Cat Day in the US on October 29 is the reliable engagement post at the end of a heavy month, and it is a different observance from International Cat Day back on August 8. Pick one, not both.","Finish your Black Friday creative in October. Every asset for the last week of November needs to be approved and scheduled before the month ends, because there is no room to make anything once that week starts.","Food accounts should treat October as a run rather than a set of one-offs. International Coffee Day on October 1, National Dessert Day on October 14 and National Pumpkin Day on October 26 shot in a single session gives you three posts for one afternoon of work."],extraFaq:{question:"When should I start posting Halloween content?",answer:"Around the middle of October. Halloween itself is fixed on October 31, but the searching, planning and buying happens across the two weeks before it, so content that lands from about the 15th catches the audience while they are still deciding. By the evening of the 31st the only thing that still works is showing what you or your customers actually did. If you sell anything physical, your shipping cutoff needs to be published even earlier than that."}},11:{heroLead:"November ends in the four biggest trading days of the year: Thanksgiving on November 26, Black Friday on November 27, Small Business Saturday on November 28 and Cyber Monday on November 30. All four move every year, and here is the full month with dates and hashtags.",metaDescription:"Social media holidays in November: Thanksgiving on November 26, Black Friday on November 27, Small Business Saturday on November 28, Cyber Monday on November 30.",intro:["November is quiet for three weeks and then delivers the densest commercial run of the entire year. Thanksgiving Day in the US on November 26, Black Friday on November 27, Small Business Saturday on November 28 and Cyber Monday on November 30 land inside five days, and between them they account for more retail attention than the rest of the quarter combined. Every one of those four is a floating date that hangs off the fourth Thursday of November, so the dates you used last year are wrong this year, and a scheduling mistake here is expensive in a way that a missed doughnut day is not.","The first three weeks are worth more than they look. World Vegan Day on November 1, World Kindness Day on November 13 and World Diabetes Day on November 14 are real audiences with much less competition than the last week, and Veterans Day and Remembrance Day on November 11 is a commemoration that should never carry a discount code. Use the quiet stretch to warm the audience you are about to sell to, because a follower who has heard nothing from you since October is not going to buy on the 27th."],tips:["Everything for the last week of November should be scheduled by the middle of the month. Once Thanksgiving arrives you are reacting, not creating, and the accounts that improvise that week are the ones posting a sale graphic at 11pm.","Small Business Saturday on November 28 is the best of the four for a small brand, because the day itself is about choosing independent over large. Say who you are, who makes your product and what a purchase actually pays for.","Veterans Day and Remembrance Day on November 11 is not a sale. If you post, keep it separate from anything commercial, and if you genuinely support a related organization, that is the post rather than a discount.","Use the first three weeks to build the list you sell to at the end. World Kindness Day on November 13 and World Diabetes Day on November 14 reach real audiences at a fraction of the competition of the final week.","Re-check all four end-of-month dates every year. They hang off the fourth Thursday of November, so Thanksgiving, Black Friday, Small Business Saturday and Cyber Monday shift by several days from one year to the next."],extraFaq:{question:"Is Small Business Saturday the same date every year?",answer:"No. Small Business Saturday is always the Saturday after Thanksgiving, which puts it on November 28 in 2026, and it moves every year because Thanksgiving does. The same is true of Black Friday on November 27 and Cyber Monday on November 30. All four are flagged as floating in the table, so re-check them before you copy last year's schedule forward."}},12:{heroLead:"December starts with Giving Tuesday on December 1 and ends with Christmas Day on December 25 and New Year's Eve on December 31. Here is the full month with dates, hashtags and the ones that move.",metaDescription:"Social media holidays in December: Giving Tuesday on December 1, Christmas Day on December 25, New Year's Eve on December 31 and more, with hashtags.",intro:["December is two months wearing one name. The first half is commercial and busy: Giving Tuesday on December 1 opens it, and if you sell anything physical your shipping cutoffs, gift guides and last-order posts all have to run before the middle of the month. The second half belongs to Christmas Day on December 25 and to an audience that is largely offline, which means the posts that work are the ones scheduled days earlier by someone who has already stopped working.","Then New Year's Eve on December 31 closes the year with the single most reusable format in social media: the honest year in review. Around the two big ones, World AIDS Day shares December 1 with Giving Tuesday, National Cookie Day on December 4 and National Cupcake Day on December 15 keep food accounts going, National Ugly Christmas Sweater Day on December 18 is the office post that writes itself, and Boxing Day on December 26 matters in the UK, Canada and Australia while meaning nothing in the US."],tips:["Schedule the last two weeks before you log off. Nobody wants to write a Christmas Day caption on Christmas Day, and a queue built in the first week of December is the only version of this that ever works.","Publish your shipping cutoff dates louder than your discounts. The single most useful December post for a physical product is the one that tells people the last day to order and have it arrive, and it will out-perform the promotion it protects.","Giving Tuesday on December 1 needs a real cause and a real number. Name the organization, say what you are giving and report back afterwards. A vague pledge to give back is the version that gets ignored, and it floats with Thanksgiving, so check the date each year.","National Ugly Christmas Sweater Day on December 18 is the easiest team content of the year, and it moves: it is the third Friday of December, so it is not the same date twice in a row.","Write the year in review for New Year's Eve on December 31 with real numbers rather than adjectives. What you shipped, what you got wrong and what changed will always beat a highlight reel, and it doubles as the outline for your January plan."],extraFaq:{question:"What should I post between Christmas and New Year?",answer:"Very little, and all of it scheduled in advance. The stretch between Christmas Day on December 25 and New Year's Eve on December 31 is the quietest audience of the year, so it is a poor week to launch anything and a good week for a year in review, a thank you or a quiet look ahead. Boxing Day on December 26 is worth a post if your audience is in the UK, Canada or Australia, and worth skipping if it is not."}}},W={[M]:(t=P.length,a=function(){let e=1;for(let t=2;t<=12;t+=1)C(t).length>C(e).length&&(e=t);return{label:L(e),count:C(e).length}}(),o=P.filter(e=>e.floatingNote).length,{slug:M,family:"holidays",platform:null,datePublished:D,lastUpdated:D,label:"Social media holidays",metaTitle:`Social Media Holidays Calendar 2026: All ${t} Dates`,metaDescription:`Free social media holidays calendar for 2026: all ${t} dates across twelve months with hashtags, top picks and floating dates resolved. No signup to read it.`,heroEyebrow:"Free tool",heroTitle:"Social Media Holidays Calendar",heroLead:`Every social media holiday worth knowing about in 2026, ${t} dates across twelve months, each with its hashtag, its category and an honest note on whether it is worth a post. Open any month for the full table.`,intro:["A social media holiday calendar solves one specific problem: the Tuesday morning where you have to publish something and have no idea what. It does not replace the posts that matter, the customer stories and the product news and the thing you actually know more about than anyone else. It fills the gaps between them with days people are already talking about, which is a much easier place to start than a blank composer.",`This calendar carries ${t} observances across the year, from New Year's Day on January 1 to New Year's Eve on December 31, with ${q} of them marked as top picks: the ones with wide enough recognition that a post has somewhere to land. ${o} of them float, meaning the date is set by a rule rather than a number, and every one of those has been resolved for 2026 and carries a note saying how. That is the part most calendars get wrong, and it is the part that breaks a schedule copied forward from last year.`,`Every month below is a full page with the complete table: date, observance, hashtag and category, with the top picks highlighted. Nothing is hidden behind a form. If you would rather have the year in one place, the band further down will email you all ${q} top picks in a single message, which is the same data you can read here for free.`],tips:["Pick two or three dates a month and ignore the rest. A feed that posts for every observance on a list reads as automated, and the accounts that get value out of a calendar like this one are the ones that use it as a menu rather than a schedule.","Never force a holiday onto a brand it does not fit. If the connection between the day and what you sell takes a paragraph to explain, there is no connection, and your audience can tell. Skipping a date costs you nothing at all.","Work backwards from the date, not forwards from today. Anything involving photography, a landing page or physical stock needs two to three weeks, so a date on the 20th is really a briefing on the 1st.",`Re-check every floating date each year. ${o} of the ${t} entries here are set by a rule rather than a fixed number, and Thanksgiving, Easter, Mother's Day and the whole Black Friday weekend move by days from one year to the next.`,"Watch which country a date belongs to. Independence Day, Labor Day, Thanksgiving and Mother's Day all mean different things or different dates depending on where your audience is, and a single global send is how that goes wrong.","Put the big commercial dates in your calendar first and build the rest around them. The last week of November is worth more than every food day of the year combined, and it needs its assets finished long before it arrives."],faqs:[{question:"Are these dates the same every year?",answer:`Some are and some are not. Fixed observances such as Valentine's Day on February 14 or World Emoji Day on July 17 never move. ${o} of the ${t} entries here are floating, meaning the date comes from a rule such as the fourth Thursday of November or the second Sunday of May, so it lands on a different number each year. Every floating entry is resolved for 2026 and carries a note in the table explaining the rule, which tells you exactly which rows to re-check next year.`},{question:"Do I have to post for every one of these?",answer:`No, and you should not. ${t} dates a year is a menu, not a quota. Two or three a month that genuinely connect to what you sell will do more than thirty that do not, and an audience notices very quickly when an account is posting for a day rather than for a reason. The ${q} top picks are the widest-recognition dates, and they are a good place to start narrowing.`},{question:"What is in the emailed calendar?",answer:`One message with the top picks for all twelve months, ${q} dates in total, so you can block out a year in a single sitting. It is generated from the same dataset that renders these pages, so it can never disagree with them. The month tables on this site are free and complete either way: the email is a convenience, not a paywall on the dates.`},{question:"Where do these dates come from?",answer:`Public observance calendars, national holiday listings and the industry roundups that track the newer hashtag days, cross-checked against each other and resolved for 2026. Which observances made the list, and which ${q} are the ones most people recognize, is our curated estimate rather than measured data. Dates tied to one country move or do not exist elsewhere, so check anything time critical against a local calendar before you schedule it.`},{question:"Is anything stored when I use this page?",answer:"Only your email address, and only if you ask for the year calendar. Every month table on this site is rendered on our server and ships inside the page, so reading it needs no account and no input from you. If you request the calendar we receive your address and which page you asked from, so we can send it and know which page produced it. Marketing email is a separate checkbox that starts unticked."},{question:"Which month has the most social media holidays?",answer:`${a.label}, with ${a.count} entries. The months are not far apart though, and volume is a poor guide to value: the last week of November carries four dates and is worth more to most businesses than the whole of ${a.label}. Read the top picks rather than the counts.`}],relatedToolSlugs:["content-calendar-generator","best-time-to-post","social-media-post-preview","social-media-character-counter"]}),...Object.fromEntries(I.map((e,t)=>{let a,o,s,n,r,i,l,h,d,c,u,m,p,g,y=t+1;return[F(y),(a=L(y),o=O[y],s=C(y),{slug:F(y),family:"holidays",platform:null,datePublished:D,lastUpdated:D,label:`${a} holidays`,metaTitle:`${a} Social Media Holidays 2026: ${s.length} Dates`,metaDescription:o.metaDescription,heroEyebrow:"Free tool",heroTitle:`Social Media Holidays in ${a} 2026`,heroLead:o.heroLead,intro:[...o.intro,(n=L(y),r=C(y),i=A(y),h=0===(l=r.filter(e=>e.floatingNote)).length?`Every one of them sits on a fixed date, so ${n} reads the same in 2026 as it will in any other year.`:1===l.length?`One of them, ${l[0].name}, moves from year to year and is resolved here for 2026, with a note in the table saying which rule it follows.`:`${l.length} of them move from year to year and are resolved here for 2026, each with a note in the table saying which rule it follows.`,`The table below lists all ${r.length} ${n} observances in this calendar, ${i.length} of them flagged as top picks, with the hashtag next to each one so you are not guessing at the spelling. ${h} Nothing on this page is gated: the email at the bottom is the year at a glance in one message, for people who would rather plan twelve months in one sitting than come back to twelve pages.`)],tips:o.tips,faqs:[...(d=L(y),c=C(y),u=A(y),m=c.filter(e=>e.floatingNote),p=u.find(e=>!e.floatingNote)??c.find(e=>!e.floatingNote),g=R(u.map(e=>B(e))),[{question:"Are these dates the same every year?",answer:0===m.length?`In ${d}, yes. Every ${d} entry in this calendar sits on a fixed date, so ${g} fall on the same days in 2026 as they will in any other year, and you can plan this month years ahead. Other months are not so tidy: Thanksgiving, Easter and Mother's Day are all floating, and every floating entry on this site is resolved for 2026 and carries a note explaining the rule it follows.`:`Some are, some are not. Fixed dates such as ${p?B(p):"the ones without a note"} are the same every year and can be planned indefinitely ahead. ${1===m.length?`One ${d} entry floats: ${B(m[0])} this year.`:`${m.length} ${d} entries float: ${R(m.map(e=>B(e)))} this year.`} Every floating entry is resolved for 2026 and carries a note in the table explaining the rule behind it, which tells you exactly which rows to re-check when the year rolls over.`},{question:"Do I have to post for every one of these?",answer:`Definitely not, and trying is the fastest way to make a feed look automated. ${c.length} observances in ${d} is a menu, not a quota. Pick the two or three a customer would actually connect to what you sell, and let the rest go by without comment. The table flags ${u.length} top picks for ${d}, ${g}, as the ones with the widest recognition, and even those only earn a post if you have something real to say on the day.`},{question:"What is in the emailed calendar?",answer:`One message with the top picks for all twelve months, ${q} dates in total, so you can block out a year in one sitting instead of visiting twelve pages. It is built from the same dataset this page is rendered from, so nothing in it contradicts what you are reading. To be clear about what the form is and is not: the full ${d} table above is free, complete and needs no email at all.`},{question:"Where do these dates come from?",answer:`Public observance calendars, national holiday listings and the industry roundups that track the newer hashtag days, cross-checked against each other and resolved for 2026. Which observances make the list, and which ${u.length} in ${d} are the ones most people recognize, is our curated estimate rather than measured data. Anything tied to one country moves or does not exist elsewhere, so check anything time critical against a local calendar before you schedule it.`},{question:"Is anything stored when I use this page?",answer:`Only your email address, and only if you ask for the year calendar. The ${d} table is rendered on our server and ships inside the page, so reading it involves no account, no tracking of what you looked at and no input from you at all. If you do request the calendar we receive your address and which page you asked from, so we can send it and know which page produced it. Marketing email is a separate checkbox that starts unticked.`}]),o.extraFaq],relatedToolSlugs:[F(1===y?12:y-1),F(12===y?1:y+1),"content-calendar-generator","best-time-to-post"]})]}))},_="2026-08-06",U="2026-08-03",z="2026-07-31",G="2026-08-03",H="2026-08-06",Y="2026-08-06",$="2026-08-06",K="2026-08-03";Object.keys({"social-media-character-counter":{slug:"social-media-character-counter",family:"character-counter",platform:null,datePublished:k,lastUpdated:k,label:"Social media character counter",metaTitle:"Social Media Character Counter for 8 Networks",metaDescription:"Free character counter for Instagram, TikTok, X, LinkedIn and more. Check caption limits, hashtags, and where each network cuts your text off.",heroEyebrow:"Free tool",heroTitle:"Social Media Character Counter",heroLead:"Paste one caption and watch it land on all 8 networks at once, from the 280 characters X gives you to the 63,206 Facebook will technically accept.",intro:['Every network counts differently and almost none of them show you the whole caption. X stops you at 280. Instagram allows 2,200 but hides everything past roughly the first line. LinkedIn accepts 3,000 and displays about 210 of them before a "...see more" link takes over.',"That gap between what is allowed and what is visible is where most captions go wrong. A post that fits comfortably inside the limit can still fail, because the sentence doing the persuading sits below a fold nobody taps.","This counter runs your text against all 8 networks at the same time. It tracks the hard ceilings, the hashtag and mention caps that make Instagram reject a post outright, the 23 character weight X applies to every link, and the point on each network where your caption gets folded away. Nothing is uploaded and nothing is stored."],tips:["Write for the tightest network in your set first, then expand. Cutting 3,000 characters down to 280 usually destroys the hook; growing 280 into 3,000 rarely does.",'Check the fold, not just the limit. Every network except a standard X post hides most of your caption behind a "more" control, and the words above that line decide whether anyone expands it.',"Hashtags and mentions spend the same budget as words on Instagram, TikTok and YouTube. A block of 30 tags is not free, and it is not extra reach either.","Emoji and flags look like one character but are several code points underneath. This counter measures what you see on screen, which is what the apps display back to you.","Keep one canonical caption and adapt it per network rather than pasting the same block everywhere. The same idea at 280 and at 3,000 characters is genuinely two different posts."],faqs:[{question:"Which platform has the longest caption limit?",answer:"Facebook, by a wide margin: a post can run to 63,206 characters. YouTube descriptions come next at 5,000, then TikTok at 4,000 and LinkedIn at 3,000. None of those numbers are a target, they are just the point where the field stops accepting input."},{question:"Which platform has the shortest caption limit?",answer:'X, at 280 characters for a standard account. Threads and Pinterest descriptions are next at 500 each. X Premium accounts can go to 25,000, but the timeline still only shows the first 280 before a "Show more" toggle.'},{question:"Do hashtags and mentions count toward the character limit?",answer:"Yes, on every network here. A hashtag is just text with a # in front of it. Instagram additionally caps you at 30 hashtags and 20 mentions per caption, and YouTube ignores every hashtag on a video once you pass 15."},{question:"Why does a link cost 23 characters on X?",answer:"X rewrites every URL through its own t.co wrapper, and the wrapper is a fixed length. That means a 15 character link and a 180 character tracking link both cost 23, so there is no point shortening URLs for X specifically. No other network here does this."},{question:"Do emoji count as one character?",answer:"Visually yes, technically it depends. A plain emoji is usually one or two code points, a flag or a skin tone variant can be four or more. This tool counts grapheme clusters, which is what a reader perceives as one character and the closest match to what the composers show."},{question:"Is this character counter free?",answer:"Yes, and there is no account, no email step and no upload. The counting happens in your browser, so your caption never leaves the page you are reading."}],relatedToolSlugs:["instagram-character-counter","twitter-character-counter","linkedin-character-counter","social-media-video-size-checker","ads-character-counter"]},"instagram-character-counter":{slug:"instagram-character-counter",family:"character-counter",platform:"instagram",datePublished:k,lastUpdated:k,label:"Instagram character counter",metaTitle:"Instagram Character Counter and Caption Checker",metaDescription:"Count Instagram caption characters against the 2,200 limit, track your 30 hashtags and 20 mentions, and see exactly where the 125 character fold lands.",heroEyebrow:"Free Instagram tool",heroTitle:"Instagram Caption Checker and Character Counter",heroLead:'Instagram gives you 2,200 characters, 30 hashtags and 20 mentions, but only about 125 characters survive before the "... more" link folds the rest away.',intro:['An Instagram caption holds 2,200 characters. That is more room than almost anyone uses, and it is not the number that decides whether a caption works. The feed collapses your text after roughly 125 characters behind a "... more" link, so the opening sentence is doing all of the work.',"The two caps that actually bite are hashtags and tags: 30 hashtags per caption and 20 accounts mentioned. Cross either one and Instagram refuses the caption outright rather than trimming it, which is a frustrating way to lose a post you already scheduled.","This counter tracks all three numbers as you type and marks the spot where the fold lands, so you can move the hook above it before anything gets published."],tips:["Put the hook inside the first 125 characters. Everything after the fold is opt in, and most of the feed never opts in.","Use line breaks. Instagram preserves them in captions, and a three line caption with air around it reads far better than one dense block of text.","Stay well under 30 hashtags. Instagram rejects the caption at 31 rather than trimming it, and 3 to 5 relevant tags reliably beat a wall of thirty.","Keep mentions under 20 and check that every handle exists. A mistyped @ tag still counts against the cap without tagging anyone.","Only move context into the first comment when it genuinely is an afterthought. Instagram reads caption text for search and treats comments as far weaker signal."],faqs:[{question:"How many characters can an Instagram caption have?",answer:"An Instagram caption can hold up to 2,200 characters, including spaces, emoji, hashtags and mentions. The limit is the same for feed posts, carousels and Reels."},{question:"Where does Instagram cut off captions?",answer:'The feed shows roughly the first 125 characters and hides the rest behind a "... more" link. The exact cut depends on screen width and whether your caption has line breaks, so treat 125 as a working ceiling for the visible part.'},{question:"How many hashtags can I use on Instagram?",answer:"Thirty per caption is the hard cap. Add a thirty-first and Instagram rejects the caption instead of dropping the extra tag. In practice 3 to 5 specific hashtags perform better than a block of thirty broad ones."},{question:"Do hashtags count toward the 2,200 character limit?",answer:"Yes. Hashtags, @ mentions, emoji, spaces and line breaks are all charged against the same 2,200 characters. Thirty hashtags at an average of 15 characters each spends about a fifth of the caption before you write a word."},{question:"How many accounts can I tag in an Instagram caption?",answer:"Twenty. That is separate from the people you tag on the image itself, which has its own limit of 20 per photo. Both caps are enforced when you publish, not while you type."},{question:"Do Reels captions have the same limit?",answer:"Yes, Reels use the same 2,200 character caption field as feed posts, with the same 30 hashtag and 20 mention caps. The visible portion is smaller though, because the caption overlays the video rather than sitting under it."}],relatedToolSlugs:["instagram-video-size-checker","social-media-character-counter","facebook-character-counter","threads-character-counter"]},"facebook-character-counter":{slug:"facebook-character-counter",family:"character-counter",platform:"facebook",datePublished:k,lastUpdated:k,label:"Facebook character counter",metaTitle:"Facebook Character Counter and Post Limit Check",metaDescription:"Facebook allows 63,206 characters per post but folds after about 477. Count your post, hashtags and mentions before you hit publish.",heroEyebrow:"Free Facebook tool",heroTitle:"Facebook Post Checker and Character Counter",heroLead:'Facebook lets a post run to 63,206 characters, yet only about 477 of them show before the "See more" link swallows everything else.',intro:['The Facebook post limit is 63,206 characters, a number that comes from an old field size rather than from anything about how people read. You will never reach it. What you will hit is the "See more" link, which folds the post after roughly 477 characters on desktop and earlier on a narrow phone.',"Length works against you here more than on any other network. Short posts, in the region of 40 to 80 characters, consistently pull more reactions and comments than the same idea told at length, which puts the practical limit closer to two sentences than to sixty thousand characters.","Use the counter to see where your fold lands, confirm the tagged Pages and hashtags are where you meant them to be, and check the same text against the tighter networks before you cross-post it."],tips:["Aim for one or two sentences. Posts of roughly 40 to 80 characters consistently outperform long ones on Facebook, whatever the ceiling says.",'Front-load the point above the 477 character fold. The "See more" click is a real drop-off, not a formality.',"Facebook does not give links a fixed cost the way X does, so a long tracking URL spends every one of its characters. Shorten it before you paste.","Hashtags do very little on Facebook. One or two for a campaign is fine, a block of them reads as an Instagram caption pasted into the wrong app.","If the idea genuinely needs length, publish it somewhere with a permalink and use the post to sell the click instead."],faqs:[{question:"How many characters can a Facebook post have?",answer:"A Facebook post can hold up to 63,206 characters. It is the highest ceiling of any major network, and almost entirely theoretical: the vast majority of posts that perform well are under 200 characters."},{question:"Where does Facebook cut off a post?",answer:'The desktop feed collapses a post behind "See more" at around 477 characters. Mobile folds earlier, depending on screen width and whether your text contains line breaks.'},{question:"What is the ideal Facebook post length?",answer:"Short. Posts in the 40 to 80 character range tend to earn the most engagement, and anything under the 477 character fold at least gets read in full. Treat longer posts as a deliberate choice, not a default."},{question:"Do hashtags and links count toward the Facebook character limit?",answer:"Yes, everything in the composer counts: hashtags, @ mentions of people and Pages, emoji, line breaks and the full text of any URL you paste. Facebook does not compress links into a fixed character cost."},{question:"Is the limit different for Facebook Reels and Stories?",answer:"Yes. Reels use a much shorter description field than feed posts, and Stories are built around text overlays rather than a caption. This counter measures the standard Page or profile post, which is the field the 63,206 limit applies to."}],relatedToolSlugs:["facebook-video-size-checker","social-media-character-counter","instagram-character-counter","threads-character-counter"]},"threads-character-counter":{slug:"threads-character-counter",family:"character-counter",platform:"threads",datePublished:k,lastUpdated:k,label:"Threads character counter",metaTitle:"Threads Character Counter and Post Limit Tool",metaDescription:"Threads caps every post at 500 characters. Count yours, plan where the chain should break, and see how the same text fits X and Instagram.",heroEyebrow:"Free Threads tool",heroTitle:"Threads Post Checker and Character Counter",heroLead:"Threads gives every post 500 characters and a single topic tag, so anything longer has to be split into a chain rather than stretched.",intro:["Threads keeps posts short on purpose: 500 characters each, the same ceiling it launched with. That is about three or four sentences, which is room for one clear idea and not much else.","When you need more, the answer is a chain. Reply to your own post and keep going; each reply gets a fresh 500 characters and the whole thing reads as one unit. Breaking on a sentence boundary rather than mid-thought is the difference between a chain that reads deliberately and one that reads like a truncation bug.","Threads also broke with the hashtag habit. A post carries a single topic tag instead of a block of them, and that tag is charged against the same 500 characters as everything else."],tips:["Split at sentence boundaries, never at exactly 500. A chain that breaks mid-clause reads as a technical failure rather than as pacing.","The first post in a chain is the only one most people see in the feed, so it has to work as a standalone statement.","One topic tag per post, and pick one people would actually browse. There is no equivalent of an Instagram style tag block here.","Links are not weighted on Threads the way they are on X. A long URL spends every one of its characters, so shorten it before you paste.","Cross-posting a full 2,200 character Instagram caption will not fit. Rewrite it for 500 rather than letting something truncate it for you."],faqs:[{question:"How many characters can a Threads post have?",answer:"Five hundred characters per post, including spaces, emoji, links and the topic tag. The limit applies to every post in a chain individually, not to the chain as a whole."},{question:"Can I write longer posts on Threads?",answer:"Not in a single post. The way around it is to reply to your own post and continue there, which gives you another 500 characters per reply. Threads displays the chain together, so readers experience it as one longer piece."},{question:"How many hashtags can I use on Threads?",answer:"One. Threads replaced the traditional hashtag block with a single topic tag per post, and its text counts toward your 500 characters like anything else."},{question:"Do links count as full characters on Threads?",answer:"Yes. Unlike X, which charges a flat 23 characters for any URL, Threads counts the entire link as written. A long tracking URL can eat a fifth of your post."},{question:"Is the Threads limit the same as Instagram?",answer:"No, and the gap is large. Instagram allows 2,200 characters per caption, Threads allows 500. If you publish to both from one draft, write for 500 and expand for Instagram rather than the other way round."}],relatedToolSlugs:["threads-video-size-checker","social-media-character-counter","twitter-character-counter","instagram-character-counter"]},"linkedin-character-counter":{slug:"linkedin-character-counter",family:"character-counter",platform:"linkedin",datePublished:k,lastUpdated:k,label:"LinkedIn character counter",metaTitle:"LinkedIn Character Counter and Post Limit Tool",metaDescription:'LinkedIn posts stop at 3,000 characters and collapse after about 210. Count your post and get the hook right before the "see more" link.',heroEyebrow:"Free LinkedIn tool",heroTitle:"LinkedIn Post Checker and Character Counter",heroLead:'A LinkedIn post holds 3,000 characters, but only about 210 survive on desktop and closer to 140 on mobile before "...see more" takes over.',intro:['The LinkedIn post limit is 3,000 characters. The number worth planning around is 210, because that is roughly where the desktop feed drops in a "...see more" link and stops showing the rest. On mobile it is tighter still, closer to 140.',"That makes the first two lines the entire pitch. Everything underneath is read only by people who already decided to expand it, which is why the LinkedIn posts that travel front-load the claim and leave the reasoning below the fold.","LinkedIn does not publish a hashtag cap, but the feed treats a wall of them as noise. Three to five at the end, chosen because someone might actually follow them, is the pattern that still works."],tips:['Treat the first 210 characters as the whole post. That is what desktop shows before "...see more", and mobile shows even less.',"Break the line early. A one line opener followed by white space earns noticeably more expands than a dense paragraph of identical length.","Three to five hashtags at the end. LinkedIn imposes no hard cap, but the feed rewards restraint over volume.","If a post needs an external link, consider putting it in the first comment and saying so in the post itself.","Your profile headline is a separate 220 character field with its own indexing. Do not spend post characters repeating what it already says."],faqs:[{question:"How many characters can a LinkedIn post have?",answer:"Three thousand characters for a standard feed post, including spaces, emoji, hashtags and mentions. Documents, polls and articles are separate formats with their own fields."},{question:"Where does LinkedIn cut off a post?",answer:'Desktop collapses the post behind "...see more" at around 210 characters. Mobile folds closer to 140. Because most LinkedIn traffic is mobile, writing to the smaller number is the safer habit.'},{question:"How many characters is a LinkedIn headline?",answer:"Two hundred and twenty characters on the profile headline field. It is indexed separately from your posts and shows up next to your name everywhere on the platform, so it is worth its own draft."},{question:"How many hashtags should I use on LinkedIn?",answer:"Three to five. LinkedIn does not enforce a maximum, but hashtags spend characters from the same 3,000 and a long tag block at the end of a post visibly lowers how professional it reads."},{question:"Do LinkedIn articles have the same character limit?",answer:"No. Articles are a long-form format with a ceiling in the region of 110,000 characters, roughly thirty-five times a feed post. They are indexed by search engines too, which posts are not."}],relatedToolSlugs:["linkedin-video-size-checker","social-media-character-counter","twitter-character-counter","facebook-character-counter"]},"twitter-character-counter":{slug:"twitter-character-counter",family:"character-counter",platform:"twitter",datePublished:k,lastUpdated:k,label:"X (Twitter) character counter",metaTitle:"X (Twitter) Character Counter with Link Weighting",metaDescription:"Count X posts against the 280 character limit with every link weighted at 23 characters. X Premium raises the ceiling to 25,000.",heroEyebrow:"Free X tool",heroTitle:"X (Twitter) Post Checker and Character Counter",heroLead:"X counts 280 characters for everyone, charges a flat 23 for any link however long it is, and lifts Premium accounts to 25,000.",intro:["X gives every account 280 characters. Links are the part that catches people out: whatever URL you paste gets rewritten through t.co and charged at a flat 23 characters, so a 12 character link and a 200 character tracking link cost you exactly the same.",'X Premium raises the ceiling to 25,000 characters, but it does not change what the timeline shows. Anything past 280 collapses behind a "Show more" toggle, which means the first 280 are still the part that has to earn the tap.',"This counter applies the 23 character link weight automatically. Read the result as very close rather than exact: media attachments cost nothing, the leading @ mentions in a reply are free, and X adjusts the edges of its counting from time to time."],tips:["One link costs 23 characters. Two links cost 46, so a post with a source and a call to action loses a sixth of its budget before you type a word.","Leading @ mentions in a reply are free, but a handle in the middle of the text is not. Move mentions to the front when you are tight.","Media attachments do not spend characters at all. A screenshot is often the cheapest way to add the detail that will not fit.",'If you have Premium and go long, still write the first 280 as a post that stands alone. That is everything the timeline shows before "Show more".',"A chain of short posts still outperforms one long post for most accounts, Premium or not."],faqs:[{question:"How many characters is a post on X?",answer:"Two hundred and eighty characters on a standard account, which has been the limit since 2017. X Premium subscribers can publish up to 25,000 characters in a single post."},{question:"How does X count links?",answer:"Every URL is wrapped in a t.co link and charged at 23 characters regardless of its real length. Shortening a URL before you paste it saves you nothing on X, though it still helps everywhere else."},{question:"Do images, videos and quoted posts use characters?",answer:"No. Attached photos, videos and GIFs cost nothing against the 280, and the link X adds when you quote another post is not charged either. Only text you type counts."},{question:"How many characters does X Premium allow?",answer:'Twenty-five thousand. The extra room is real, but posts over 280 characters are collapsed behind a "Show more" control in the timeline, so long posts only work when the visible opening carries its own weight.'},{question:"Do hashtags and mentions count toward the 280 limit?",answer:"Yes, with one exception: when you reply to someone, the @ handles at the very start of the reply are not counted. Hashtags always count, as does any mention placed inside the body of the post."},{question:"What happens if my post goes over 280 characters?",answer:"X blocks it. The post button stays disabled and the overflowing characters are highlighted in the composer, so nothing gets silently truncated. Split the idea into a chain or trim it before publishing."}],relatedToolSlugs:["twitter-video-size-checker","social-media-character-counter","threads-character-counter","linkedin-character-counter"]},"tiktok-character-counter":{slug:"tiktok-character-counter",family:"character-counter",platform:"tiktok",datePublished:k,lastUpdated:k,label:"TikTok character counter",metaTitle:"TikTok Character Counter and Caption Limit Tool",metaDescription:"TikTok video descriptions run to 4,000 characters and photo post titles to 90. Count your caption, hashtags and mentions before you upload.",heroEyebrow:"Free TikTok tool",heroTitle:"TikTok Caption Checker and Character Counter",heroLead:"TikTok raised video descriptions from 2,200 to 4,000 characters, and every hashtag, mention and emoji spends part of that same budget.",intro:["TikTok video descriptions run to 4,000 characters, up from the 2,200 the app allowed for years. The extra room is genuinely useful, because TikTok reads the caption for context and its in-app search leans heavily on the words you put there.","Everything shares that budget: hashtags, @ mentions, emoji and spaces are all charged against the same 4,000. A caption padded with twenty hashtags spends a real slice of it on text nobody reads and no algorithm rewards.","Photo posts are a separate format. They carry a title of up to 90 characters on top of the description, so a caption that fits a video will not always drop cleanly into a slideshow."],tips:["Say what the video actually is, in plain words. TikTok search reads the caption, and a caption of pure vibes leaves it guessing.","Keep hashtags to a handful of specific ones. They cost the same characters as your sentences, and a wall of them does not widen reach.",'Only about the first line shows over the video before the "more" toggle, so put the hook there and let the context sit behind it.',"Photo posts need a title of 90 characters or fewer on top of the description. Draft that separately rather than trimming the caption to fit.","Do not paste an Instagram caption straight across. Line breaks and tag blocks that look tidy in a feed look cramped over a full screen video."],faqs:[{question:"How many characters can a TikTok caption have?",answer:"Four thousand characters in the video description field. TikTok raised it from 2,200, so older guides and older third party tools still quote the smaller number."},{question:"Do hashtags count toward the TikTok caption limit?",answer:"Yes. Hashtags, @ mentions, emoji and spaces all come out of the same 4,000 characters. TikTok does not enforce a separate hashtag cap, which means a tag block can quietly consume a large part of your caption."},{question:"How many hashtags should I use on TikTok?",answer:"Three to five specific ones beat twenty broad ones. Tags help TikTok categorise the video, they do not multiply distribution, and a caption that is mostly hashtags reads as low effort to viewers."},{question:"What is the character limit for TikTok photo posts?",answer:"Photo posts add a title field capped at 90 characters, alongside the same description field. The title is what appears most prominently, so it needs to work on its own."},{question:"Where does TikTok cut off the caption?",answer:'Roughly one line, around 100 characters, before a "more" toggle. The exact point depends on device width and orientation, so aim to have the hook well inside the first sentence.'}],relatedToolSlugs:["tiktok-video-size-checker","social-media-character-counter","instagram-character-counter","youtube-character-counter"]},"youtube-character-counter":{slug:"youtube-character-counter",family:"character-counter",platform:"youtube",datePublished:k,lastUpdated:k,label:"YouTube character counter",metaTitle:"YouTube Title and Description Character Counter",metaDescription:'YouTube titles stop at 100 characters and descriptions at 5,000, with only about 157 shown before "Show more". Count both before you publish.',heroEyebrow:"Free YouTube tool",heroTitle:"YouTube Description and Title Character Counter",heroLead:'YouTube gives you 100 characters for the title, 5,000 for the description, and roughly 157 of those before the "Show more" fold.',intro:["YouTube splits the job across two fields that behave very differently. The title takes 100 characters and carries almost all of the ranking weight. The description takes 5,000 and carries the context, the links, the timestamps and the credits.",'Only about 157 characters of the description appear above the "Show more" fold on the watch page, and that same opening is usually what Google lifts into a search snippet. Anything you need a viewer or a crawler to see belongs in that first paragraph, not in the seventh.',"Hashtags are capped at 15. Only the first three ever show above the video title, and going past 15 makes YouTube ignore every hashtag on the video rather than just the extras. The counter below measures the description; the title limit sits in the comparison table further down."],tips:["Keep the title under about 60 characters if search matters to you. YouTube accepts 100, but most surfaces truncate the title long before that.","Treat the first 157 characters of the description as the preview. Put the summary and the single most important link there.","Timestamps become chapters only if the first one is 0:00 and there are at least three of them, each at least ten seconds apart.","Cap hashtags at 15. Past that YouTube ignores all of them, and only the first three ever appear above the title anyway.","Shorts use the same title and description fields as long-form videos, so a description written for search still earns its place on a 30 second clip."],faqs:[{question:"How many characters can a YouTube title have?",answer:"One hundred characters, including spaces. Search results, suggested videos and mobile home feeds all truncate earlier, typically somewhere between 60 and 70 characters, so the front of the title does the work."},{question:"How long can a YouTube description be?",answer:"Five thousand characters. That covers the summary, links, timestamps, credits and any disclosures. It is generous enough that the real constraint is the reader, not the field."},{question:"How much of a YouTube description is visible?",answer:'About 157 characters on the watch page before the "Show more" control, which is also roughly what Google shows in a search snippet. Everything below that point needs a deliberate click.'},{question:"How many hashtags can I add to a YouTube video?",answer:"Fifteen. Only the first three appear above the video title, and if you add more than 15 YouTube ignores every hashtag on the video instead of trimming the list."},{question:"Do YouTube Shorts have different character limits?",answer:"No. Shorts use the same 100 character title and 5,000 character description as regular uploads. The difference is that far less of the description is visible in the Shorts player, so the title has to carry more."}],relatedToolSlugs:["youtube-video-size-checker","social-media-character-counter","tiktok-character-counter","instagram-character-counter"]},"pinterest-character-counter":{slug:"pinterest-character-counter",family:"character-counter",platform:"pinterest",datePublished:k,lastUpdated:k,label:"Pinterest character counter",metaTitle:"Pinterest Character Counter for Titles and Pins",metaDescription:"Pinterest titles hold 100 characters and Pin descriptions 500, but only the first 50 to 60 show in the feed. Count yours before you pin.",heroEyebrow:"Free Pinterest tool",heroTitle:"Pinterest Pin Checker and Character Counter",heroLead:"Pinterest gives a Pin 100 characters of title and 500 of description, and shows only the first 50 to 60 of that description in the feed.",intro:["Pinterest behaves like a search engine wearing a feed. A Pin title takes 100 characters, the description takes 500, and both are read by the index rather than skimmed by a scrolling audience.","In the feed itself only the first 50 to 60 characters of the description are visible under the Pin. The rest opens when someone taps through, which makes the opening line a promise and everything after it the detail that justifies the click.","Write for a person typing a query, not for a hashtag block. Natural keywords in the first sentence do far more for a Pin than a list of tags appended at the end, and the counter below marks exactly where the feed stops showing your text."],tips:["Make the first 50 to 60 characters of the description a complete thought. That is the entire visible portion in the feed.","Repeat the key phrase naturally across the title and description. Pinterest reads both, and a Pin that reads like a search result gets found like one.","Keep titles inside 100 characters but expect roughly the first 40 to show under the Pin image, so front-load the subject.","Hashtags are allowed up to 20 and rarely worth more than a few. Plain descriptive sentences outperform tag lists on Pinterest.","Give every Pin pointing at the same URL its own title and description. Duplicating the text across variants wastes the second Pin entirely."],faqs:[{question:"How many characters can a Pinterest description have?",answer:"Five hundred characters in the Pin description field. It is indexed for search, so the characters you spend on clear, specific language are the ones that pay you back."},{question:"How long can a Pinterest title be?",answer:"One hundred characters. Roughly the first 40 appear under the Pin in the feed and in board views, so put the subject at the front and save the qualifiers for the description."},{question:"How much of a Pin description is visible in the feed?",answer:"Only the first 50 to 60 characters. Everything else appears once someone opens the Pin, which is why the opening line should read as a complete statement rather than a fragment."},{question:"How many hashtags can I use on Pinterest?",answer:"Up to 20, though they carry far less weight than they do elsewhere. Pinterest has leaned back toward plain keyword text, so two to five relevant tags at most, and only when they genuinely describe the Pin."},{question:"Do keywords in the Pin description actually help?",answer:"Yes. Pinterest matches queries against the title, description and board context, so a description written in the words someone would actually search is doing double duty as copy and as metadata."}],relatedToolSlugs:["pinterest-video-size-checker","social-media-character-counter","instagram-character-counter","youtube-character-counter"]},"social-media-video-size-checker":{slug:"social-media-video-size-checker",family:"media-checker",platform:null,datePublished:z,lastUpdated:z,label:"Social media video size checker",metaTitle:"Social Media Video Size Checker for 8 Networks",metaDescription:"Free video and image size checker. Drop a file and see whether it fits Instagram Reels, TikTok, YouTube Shorts, X, LinkedIn, Facebook, Threads and Pinterest.",heroEyebrow:"Free tool",heroTitle:"Social Media Video and Image Size Checker",heroLead:"Drop one file in and see where it lands. TikTok takes 4 GB, X stops at 512 MB, and a Reel wants 1080 x 1920 at 9:16 before any of that matters.",intro:["One export almost never fits everywhere. TikTok accepts 4 GB and ten minutes. A standard X account is capped at 512 MB and 2 minutes 20 seconds. YouTube will take 256 GB and twelve hours, and Pinterest wants a video Pin between 4 seconds and 15 minutes. The same file sails through on one network and bounces off the next.","Almost every failed upload comes down to three numbers: file size, duration and aspect ratio. Everything else, frame rate included, is usually a preference rather than a rule. This checker reads those three straight from your file and compares them against the format each network is known for.","The measuring happens in your browser, using the same metadata a local video player reads. Nothing is uploaded, nothing is stored, and the temporary link to the file is discarded the moment the dimensions come back."],tips:["Export vertical once at 1080 x 1920 and it covers Reels, TikTok, Shorts, Stories and video Pins. Only Facebook, LinkedIn and X really want something wider.","H.264 inside an MP4 is the one combination every network here accepts. ProRes, HEVC and MKV all need converting first, and some browsers cannot even read them.","Duration is the limit that bites hardest when cross-posting. A three minute video is an ordinary TikTok, a rejected X post, and a clip that has stopped being eligible as a Short.","Compress before uploading rather than trusting the network to be gentle. Everything is re-encoded on the way in, so a 4 GB master and a clean 200 MB export usually reach viewers looking the same.","Check the safe areas as well as the numbers. Vertical video is legal at 9:16 on five networks and covered by a different set of buttons on every one of them."],faqs:[{question:"What is the maximum video size for social media?",answer:"It depends entirely on the network. YouTube accepts up to 256 GB, LinkedIn 5 GB, TikTok 4 GB, Facebook 4 GB, Pinterest 2 GB, Threads 1 GB and X 512 MB on a standard account. Instagram publishes a 1 GB ceiling for Reels."},{question:"What size should a video be for all social media?",answer:"1080 x 1920 at 9:16, H.264 in an MP4, under 200 MB and under 60 seconds clears every network on this page with room to spare. If you only get to make one export, make that one."},{question:"Does this tool upload my video?",answer:"No. The file is read in your browser through a temporary object URL, the same way a local player opens it. Nothing reaches Postify or anyone else, which is also why a multi gigabyte file is checked instantly."},{question:"Why was my video rejected even though the file size was fine?",answer:"Duration and aspect ratio reject more uploads than size does. Anything under the minimum length fails, which is 3 seconds on Instagram and TikTok and 4 seconds on Pinterest, and so does anything outside the accepted ratio range for that format."},{question:"What aspect ratio works on the most networks?",answer:"9:16 vertical. It is the native shape for Reels, TikTok, Shorts, Stories and video Pins, and it is accepted, if not ideal, on Facebook, LinkedIn and X. Square 1:1 is the runner up and the safer choice for a feed post."},{question:"Can I check images as well as video?",answer:"Yes. Drop in a JPG or PNG and the checker measures dimensions, ratio and file size against the image formats instead, including the 4 MB Facebook ceiling and the 2 MB YouTube thumbnail limit."}],relatedToolSlugs:["instagram-video-size-checker","tiktok-video-size-checker","youtube-video-size-checker","social-media-character-counter"]},"instagram-video-size-checker":{slug:"instagram-video-size-checker",family:"media-checker",platform:"instagram",datePublished:z,lastUpdated:z,label:"Instagram video size checker",metaTitle:"Instagram Video Size Checker (Limits and Specs)",metaDescription:"Check a Reel, Story or feed post against the Instagram limits: 1 GB and 15 minutes for Reels, 8 MB for images, 1080 x 1920 at 9:16. Nothing is uploaded.",heroEyebrow:"Free Instagram tool",heroTitle:"Instagram Video and Image Size Checker",heroLead:"Reels take up to 15 minutes and 1 GB, Stories stop at 60 seconds, and a feed image has to fit inside 8 MB. Drop a file in and see which of those it clears.",intro:["Instagram runs four different sets of rules under one app. A Reel wants 1080 x 1920 at 9:16 and accepts up to 15 minutes through the publishing API, while the app itself stops you at 3 minutes. A Story card holds 60 seconds. A feed image has to come in under 8 MB. A carousel crops every slide to match the first one.","The rejections people actually run into are rarely about file size. A clip shorter than 3 seconds is refused outright. A 16:9 video uploaded as a Reel is either letterboxed or cropped into something unwatchable. A 4:5 photo squeezed into 1.91:1 loses the top and the bottom of the frame.","This checker measures your file on your device and runs it against every Instagram format at once, so you can tell whether it belongs in the feed, in a Reel or on a Story before it goes into the schedule."],tips:["Export Reels at exactly 1080 x 1920. Instagram re-encodes anything larger down to that width, so a 4K master only makes the upload slower.","Keep text and faces out of the top 250 and bottom 420 pixels of a Reel, where the profile row, the caption and the audio label sit.","Choose 4:5 over 1:1 for feed images. Portrait takes more vertical space in the feed for exactly the same photo.","Cut Story videos into 60 second segments yourself. The app splits longer clips for you, but a scheduled upload is rejected instead.","Instagram compresses hard. A clean 1080p H.264 export at around 10 Mbps survives that better than a heavy file the encoder has to fight."],faqs:[{question:"What is the maximum video size on Instagram?",answer:"Instagram publishes a 1 GB ceiling for Reels and 100 MB for a Story card. Scheduling tools, Postify included, cap the upload closer to 300 MB, so compress anything heavier before you queue it."},{question:"How long can an Instagram Reel be?",answer:"Up to 15 minutes when it is published through the API that scheduling tools use, and 3 minutes when it is recorded or trimmed inside the app. The minimum is 3 seconds either way."},{question:"What aspect ratio should Instagram videos use?",answer:"9:16 for Reels and Stories, which means 1080 x 1920. The feed accepts anything between 4:5 and 1.91:1, so a square or portrait clip works there, but only vertical fills the screen on a Reel."},{question:"What size should an Instagram photo be?",answer:"1080 x 1350 at 4:5, under the 8 MB file cap. Instagram scales everything to 1080 pixels wide on the way in, so a larger export gains you nothing at all."},{question:"Why does Instagram keep rejecting my video?",answer:"Three causes cover most of it: a clip under 3 seconds, an aspect ratio outside the range for that surface, and a file over the size cap for the format. Codec is fourth, so export H.264 in an MP4 rather than HEVC."},{question:"How many items can an Instagram carousel hold?",answer:"Between 2 and 10, and images and video can be mixed freely. Every slide is cropped to the aspect ratio of the first one, so export the whole set at the same dimensions."}],relatedToolSlugs:["instagram-character-counter","social-media-video-size-checker","facebook-video-size-checker","tiktok-video-size-checker"]},"facebook-video-size-checker":{slug:"facebook-video-size-checker",family:"media-checker",platform:"facebook",datePublished:z,lastUpdated:z,label:"Facebook video size checker",metaTitle:"Facebook Video Size Checker (Limits and Specs)",metaDescription:"Facebook accepts 4 GB and 240 minutes of video but only 4 MB per image. Check your file against the feed, Reels and Stories limits before you post.",heroEyebrow:"Free Facebook tool",heroTitle:"Facebook Video and Image Size Checker",heroLead:"Facebook is generous with video and stingy with images: 4 GB and four hours of footage, against a 4 MB ceiling on a single photo.",intro:["The published Facebook video limits are enormous: 4 GB per file and 240 minutes of runtime. The image limit runs the other way. A photo has to fit inside 4 MB, lower than any other network here allows for a post image, and it is the reason most Facebook uploads fail.","The second catch is the gap between what Facebook accepts and what a scheduling tool can send. Feed video published through the Pages API is commonly capped around 300 MB and 90 seconds. Anything longer belongs in a native upload, which is worth knowing before you plan a ten minute video around a scheduled slot.","Drop your file in below and it is checked against the feed, Reels and Stories rules at the same time, without leaving your browser."],tips:["Export photos as JPG at around quality 80. A 1200 x 630 PNG regularly sails past 4 MB while the same image as a JPG lands nearer 300 KB.","Shoot feed video at 4:5 rather than 16:9. Portrait occupies more of a phone screen, and the feed stopped rewarding widescreen years ago.","Reels are capped at 90 seconds, so a Reel and a feed cut of the same footage are two exports, not one file posted twice.","Burn in captions instead of relying on autoplay sound. Video starts muted here, and the first three seconds decide whether anyone unmutes it.","A link preview renders at 1.91:1 while a photo post keeps whatever shape you upload. Check which one you are publishing before you pick a crop."],faqs:[{question:"What is the maximum video size on Facebook?",answer:"4 GB per file, with a runtime ceiling of 240 minutes. In practice, video published through a scheduling tool goes out through the Pages API, which commonly caps the file around 300 MB and 90 seconds."},{question:"What is the Facebook image size limit?",answer:"4 MB per image, lower than any other network here allows for a post image. Only a YouTube thumbnail, at 2 MB, is tighter anywhere on this site. The recommended size is 1200 x 630, and switching the export from PNG to JPG is usually the entire fix."},{question:"How long can a Facebook Reel be?",answer:"90 seconds, with a 3 second minimum, at 1080 x 1920 in 9:16. Facebook does not publish a separate size limit for Reels, so the 4 GB video ceiling applies to them too."},{question:"What video size is best for the Facebook feed?",answer:"1080 x 1350 at 4:5. Facebook accepts anything from 9:16 to 16:9, but portrait takes the most space on mobile, where nearly all of the watching happens."},{question:"How long can a Facebook Story be?",answer:"60 seconds per card at 1080 x 1920, inside a 100 MB file. Longer clips are split into cards when you post from the app and rejected when you schedule them, so cut them yourself first."}],relatedToolSlugs:["facebook-character-counter","social-media-video-size-checker","instagram-video-size-checker","threads-video-size-checker"]},"threads-video-size-checker":{slug:"threads-video-size-checker",family:"media-checker",platform:"threads",datePublished:z,lastUpdated:z,label:"Threads video size checker",metaTitle:"Threads Video Size Checker (Limits and Specs)",metaDescription:"Threads takes video up to 5 minutes and 1 GB, images up to 8 MB, and almost any aspect ratio. Check your file against the limits before you post.",heroEyebrow:"Free Threads tool",heroTitle:"Threads Video and Image Size Checker",heroLead:"Threads has the loosest shape rules of any Meta app, accepting 0.01:1 to 10:1, with video capped at 5 minutes against 15 on an Instagram Reel and four hours on a Facebook feed video.",intro:["Threads is unusually relaxed about shape. The accepted aspect ratio range runs from 0.01:1 to 10:1, which means a thin banner and a very tall screenshot both post without complaint. Nothing gets cropped either: media is scaled to fit the post instead.","Time is the limit that bites. Video tops out at 5 minutes, against 15 on an Instagram Reel and four hours on a Facebook feed video, alongside a 1 GB file cap. Images have the same 8 MB allowance as an Instagram feed photo, and a carousel carries up to 20 items, double what Instagram allows.","The checker below reads your file on your device and reports exactly where it lands against those numbers."],tips:["Screenshots of text are the native currency here, so optimise for legibility at phone size rather than for resolution.","Keep video under 5 minutes or it will not post at all. There is no in-app trim step to fall back on the way there is on Instagram.","Anything wider than 3840 pixels is downscaled during processing, so a 4K master is the practical ceiling worth exporting to.","A Threads carousel holds 20 items and each keeps its own aspect ratio, so a mixed set of screenshots and photos stays intact.","A Reel export at 1080 x 1920 posts here unchanged, which makes Threads the cheapest network to add to an existing vertical workflow."],faqs:[{question:"What is the maximum video length on Threads?",answer:"5 minutes. That is shorter than Instagram Reels at 15 minutes and much shorter than TikTok at 10, so a long clip usually needs cutting before it can be posted here."},{question:"What is the Threads video size limit?",answer:"1 GB per file. Paired with the 5 minute ceiling, that is far more headroom than the duration limit will ever let you use."},{question:"What aspect ratio does Threads support?",answer:"Anything from 0.01:1 to 10:1, so effectively any shape at all. 4:5 for images and 9:16 for video fill the most screen, but nothing outside those is rejected."},{question:"How many images can a Threads post have?",answer:"Up to 20 in a carousel, and images and video can be mixed. Each item keeps its own aspect ratio rather than being cropped to match the first one."},{question:"What is the Threads image size limit?",answer:"8 MB per image, the same as an Instagram feed photo. 1080 x 1350 is the size worth exporting at, and PNG screenshots are fine as long as they stay under the cap."}],relatedToolSlugs:["threads-character-counter","social-media-video-size-checker","instagram-video-size-checker","twitter-video-size-checker"]},"linkedin-video-size-checker":{slug:"linkedin-video-size-checker",family:"media-checker",platform:"linkedin",datePublished:z,lastUpdated:z,label:"LinkedIn video size checker",metaTitle:"LinkedIn Video Size Checker (Limits and Specs)",metaDescription:"LinkedIn takes video up to 5 GB and 30 minutes, images up to 10 MB, and ratios from 1:2.4 to 2.4:1. Check your file against the specs before you post.",heroEyebrow:"Free LinkedIn tool",heroTitle:"LinkedIn Video and Image Size Checker",heroLead:"LinkedIn allows 5 GB and 30 minutes of native video, and accepts any shape from 1:2.4 through to 2.4:1.",intro:["LinkedIn is one of the more forgiving networks on this list. Native video runs from 3 seconds to 30 minutes at up to 5 GB, and the accepted aspect ratio range covers everything from 1:2.4 to 2.4:1. Very little is rejected on technical grounds.","That is not the same as everything working. Feed video is watched muted and mostly on a phone, so a 16:9 export of a webinar recording occupies a narrow strip of screen while a square or vertical cut of the same footage takes several times the space. Burned in captions matter more here than resolution does.","The checker reads your file locally and compares it against native video, post images and multi image posts in one pass."],tips:["Publishing through a scheduling tool usually caps the upload nearer 500 MB, well under the 5 GB LinkedIn itself allows, so compress long recordings first.","Burn captions into the file. Feed video autoplays without sound, and the automatic captions only appear once someone opens the post.","Use 1200 x 627 for a post image and the same file doubles as the link preview, which is the other place LinkedIn shows it.","The swipeable carousel LinkedIn is known for is a document post: a PDF of up to 300 pages and 100 MB, not a set of images.","Keep feed video under two minutes. The 30 minute ceiling exists for recorded sessions, not for anything you want watched all the way through."],faqs:[{question:"What is the maximum video size on LinkedIn?",answer:"5 GB per file, with a runtime between 3 seconds and 30 minutes. Uploads made through a scheduling tool are usually capped nearer 500 MB, so the platform ceiling is rarely the one you meet."},{question:"What aspect ratio does LinkedIn accept?",answer:"Anything from 1:2.4 to 2.4:1, which covers every shape you are realistically going to publish. 16:9 is the safe default for reused footage, and 1:1 or 4:5 uses more of the mobile feed."},{question:"What is the LinkedIn image size limit?",answer:"10 MB per image, as JPG, PNG or GIF. 1200 x 627 is the recommended size, and a multi image post can carry between 2 and 20 of them."},{question:"How long should a LinkedIn video be?",answer:"The technical ceiling is 30 minutes, but feed attention drops off long before that. Under two minutes is the working range for anything meant to be watched rather than referenced."},{question:"Can I post a carousel on LinkedIn?",answer:"Yes, as a document post: a PDF of up to 300 pages and 100 MB that readers swipe through in the feed. A multi image post is a separate format and holds up to 20 images."}],relatedToolSlugs:["linkedin-character-counter","social-media-video-size-checker","twitter-video-size-checker","youtube-video-size-checker"]},"twitter-video-size-checker":{slug:"twitter-video-size-checker",family:"media-checker",platform:"twitter",datePublished:z,lastUpdated:z,label:"X (Twitter) video size checker",metaTitle:"X (Twitter) Video Size Checker and Limits",metaDescription:"X caps a standard post at 512 MB and 2 minutes 20 seconds of video, and 5 MB per image. Check your file against those limits before you post.",heroEyebrow:"Free X tool",heroTitle:"X (Twitter) Video and Image Size Checker",heroLead:"A standard X account gets 512 MB and 2 minutes 20 seconds of video, plus 5 MB per image. Paid tiers move both ceilings a long way up.",intro:["The X video limits are the tightest main feed limits here: 512 MB per file and 140 seconds of runtime on a standard account through the web uploader. Images are capped at 5 MB, and animated GIFs get 15 MB from the web against 5 MB from the mobile apps.","Paid tiers change the picture completely and push the runtime ceiling from minutes into hours. Nothing about the free tier changed when they arrived, which is why a video a colleague posted without trouble can still bounce off your account.","This checker runs your file against the standard account limits, since that is the version most posts have to clear. The dimensions are read on your device and the file is never uploaded."],tips:["Cut to 140 seconds or less and the video posts from any account. Past that you are relying on a subscription rather than on the platform.","The timeline crops images to 16:9 until someone taps, so keep the subject in the middle of the frame rather than at the top or the bottom.","Four images per post is the maximum, and they are laid out as a grid of crops, so anything with text in it needs checking at that size.","Vertical or square video takes up far more of the timeline than 16:9 does, and it costs nothing to export that way.","Convert animated content to MP4 rather than GIF. It is smaller, it loops the same way, and the 15 MB GIF ceiling stops being a problem."],faqs:[{question:"What is the maximum video size on X?",answer:"512 MB from the standard web uploader, with a runtime cap of 2 minutes 20 seconds. Paid X tiers raise both limits considerably, currently into hours of footage per upload."},{question:"How long can a video be on X (Twitter)?",answer:"140 seconds on a standard account. That has been the free tier limit for years and it is the number worth editing to, because it is what everyone can post."},{question:"What is the image size limit on X?",answer:"5 MB per image for JPG, PNG and WEBP. Animated GIFs get 15 MB uploaded from the web and 5 MB from the mobile apps, and a post can carry up to 4 images."},{question:"What aspect ratio should X video use?",answer:"Anything between 1:3 and 3:1 is accepted. 16:9 at 1280 x 720 is the default, though 1:1 and 9:16 occupy more of the timeline on a phone."},{question:"Why is my video not uploading to X?",answer:"Runtime is the usual cause: anything past 140 seconds is refused on a standard account. After that, check the file is under 512 MB and encoded as H.264 in an MP4 container."}],relatedToolSlugs:["twitter-character-counter","social-media-video-size-checker","linkedin-video-size-checker","threads-video-size-checker"]},"tiktok-video-size-checker":{slug:"tiktok-video-size-checker",family:"media-checker",platform:"tiktok",datePublished:z,lastUpdated:z,label:"TikTok video size checker",metaTitle:"TikTok Video Size Checker (Limits and Specs)",metaDescription:"TikTok accepts up to 4 GB and 10 minutes through the upload API, at 1080 x 1920 in 9:16. Check your video or photo post against the limits.",heroEyebrow:"Free TikTok tool",heroTitle:"TikTok Video and Image Size Checker",heroLead:"TikTok takes 4 GB and up to 10 minutes of video, wants 1080 x 1920 at 9:16, and refuses anything shorter than 3 seconds.",intro:["TikTok takes 4 GB per upload, several times what Threads allows at 1 GB and X at 512 MB. Runtime is where it gets specific. Video published through the content posting API tops out at 10 minutes, while some accounts can reach 60 minutes from the desktop uploader.","Shape matters more here than anywhere else. TikTok is full screen 9:16, and a 16:9 video posted untouched leaves black bars across most of the frame. The caption, the sound label and the action rail also cover the bottom sixth and the right edge, which is exactly where burned in subtitles end up if nobody checks.","Photo posts follow their own rules: up to 35 images, JPEG or WEBP rather than PNG, with the first image acting as the cover. Drop either kind of file in below and it is measured in your browser."],tips:["Export at 1080 x 1920 and let TikTok do the rest. Its encoder is aggressive, and a clean 1080p H.264 file survives it better than a 4K master.","Keep subtitles above the bottom sixth of the frame, clear of the caption and the sound label.","Anything under 3 seconds is rejected outright. The shortest video worth posting is closer to 7, which is roughly where a loop starts to work.","Convert PNG exports to JPEG or WEBP before scheduling a photo post. The publishing API does not accept PNG.","Put the hook in the first frame rather than behind a title card. That frame is also the thumbnail in your profile grid."],faqs:[{question:"What is the maximum video size on TikTok?",answer:"4 GB per file, against 1 GB on Threads and 512 MB on X. It is rarely the thing that stops a TikTok upload: runtime and shape are the limits that actually bite."},{question:"How long can a TikTok video be?",answer:"10 minutes through the content posting API that scheduling tools use, and up to 60 minutes for some accounts uploading from the desktop site. The minimum is 3 seconds."},{question:"What size should a TikTok video be?",answer:"1080 x 1920 at 9:16, full screen vertical. TikTok accepts anything between 9:16 and 16:9, but wider footage is letterboxed and gives up most of the screen."},{question:"Can I post photos on TikTok?",answer:"Yes. A photo post carries up to 35 images and the first one becomes the cover. The publishing API accepts JPEG and WEBP files, so PNG exports have to be converted first."},{question:"Why is my TikTok video blurry after uploading?",answer:"TikTok re-encodes every upload. A very large or very high bitrate file gives the encoder more to throw away, so a clean 1080 x 1920 H.264 export usually looks sharper in the app than a 4K master does."}],relatedToolSlugs:["tiktok-character-counter","social-media-video-size-checker","instagram-video-size-checker","youtube-video-size-checker"]},"youtube-video-size-checker":{slug:"youtube-video-size-checker",family:"media-checker",platform:"youtube",datePublished:z,lastUpdated:z,label:"YouTube video size checker",metaTitle:"YouTube Video Size Checker (Shorts and Uploads)",metaDescription:"YouTube accepts up to 256 GB and 12 hours per video, turns anything 3 minutes or shorter and vertical into a Short, and caps thumbnails at 2 MB.",heroEyebrow:"Free YouTube tool",heroTitle:"YouTube Video and Image Size Checker",heroLead:"YouTube takes 256 GB and 12 hours per upload. The number that actually matters is 3 minutes, the line between a Short and an ordinary video.",intro:["YouTube has the largest ceilings on this site by a distance: 256 GB per file or 12 hours of runtime, whichever you reach first. Uploads longer than 15 minutes need a verified account, and that is the one gate new channels hit.","Shorts are not a separate upload. A video becomes a Short automatically when it runs 3 minutes or less and is square or taller, which means a vertical cut running 3 minutes and 5 seconds quietly becomes a normal video and stops being eligible for the Shorts feed.","Thumbnails are the other limit worth knowing: 1280 x 720 at 16:9, under 2 MB, which is a tight budget for a busy image. Drop a video or a thumbnail below and it is measured on your device."],tips:["Keep a vertical cut under 3 minutes if you want it in the Shorts feed. There is no setting for this, only the runtime and the shape.","Export Shorts at 1080 x 1920. YouTube accepts square through vertical, but 9:16 is the only ratio that fills the Shorts player.","Verify the channel before planning anything over 15 minutes. It takes a couple of minutes and it is the difference between an upload going through and being blocked.","Save thumbnails as JPG at around quality 80. A 1280 x 720 PNG frequently exceeds the 2 MB cap while the JPG version is a fraction of it.","Test thumbnail text at 210 pixels wide, which is roughly the size it appears at in search results."],faqs:[{question:"What is the maximum video size on YouTube?",answer:"256 GB per file, or 12 hours of runtime, whichever comes first. Uploads longer than 15 minutes need a verified account, so that is the practical limit until you verify."},{question:"How long can a YouTube Short be?",answer:"3 minutes, and the video also has to be square or taller. Both conditions have to hold: a 4 minute vertical video is published as an ordinary video, not a Short."},{question:"What size should a YouTube Short be?",answer:"1080 x 1920 at 9:16. YouTube treats anything from 1:1 upwards as Short eligible, but only 9:16 fills the player without bars down either side."},{question:"What are the YouTube thumbnail requirements?",answer:"1280 x 720 at 16:9, under 2 MB, as JPG, PNG or GIF. The minimum width is 640 pixels, and the same image is shown as small as 210 pixels wide in search results."},{question:"What resolution should I upload to YouTube?",answer:"1920 x 1080 covers most channels. YouTube recommends roughly 8 Mbps for 1080p and 12 Mbps at 60 fps, and re-encodes everything on the way in, so the gain is in the source quality rather than in the upload size."}],relatedToolSlugs:["youtube-character-counter","social-media-video-size-checker","tiktok-video-size-checker","instagram-video-size-checker"]},"pinterest-video-size-checker":{slug:"pinterest-video-size-checker",family:"media-checker",platform:"pinterest",datePublished:z,lastUpdated:z,label:"Pinterest video size checker",metaTitle:"Pinterest Video Size Checker (Pin Specs)",metaDescription:"Pinterest takes Pin images up to 20 MB at 1000 x 1500, and video Pins up to 2 GB from 4 seconds to 15 minutes. Check your file against the specs.",heroEyebrow:"Free Pinterest tool",heroTitle:"Pinterest Video and Image Size Checker",heroLead:"A standard Pin wants 1000 x 1500 at 2:3 and allows a generous 20 MB. Video Pins run from 4 seconds to 15 minutes at up to 2 GB.",intro:["Pinterest is the one network here where the image is the product. A standard Pin is designed around 1000 x 1500 at 2:3, and the 20 MB file allowance is tied with TikTok photo posts for the largest on this site, so there is no reason to over compress one.","Ratio is enforced by the layout rather than by a rejection. A Pin taller than 2:3 is truncated in the feed instead of being scaled down, so the bottom of a very tall infographic simply goes unseen until somebody opens it.","Video Pins take anything from 4 seconds to 15 minutes at up to 2 GB, in 9:16, 2:3, 4:5 or 1:1. They autoplay silently in the feed, which puts all the weight on the first frame. The checker below measures either kind of file on your device."],tips:["Export Pins at exactly 1000 x 1500. Larger images are downscaled on save, and 2:3 is the ratio the feed is laid out around.","Do not compress further than you have to. 20 MB is a lot of headroom, and a crisp Pin is the entire point of the network.","Make the first frame of a video Pin readable on its own. It autoplays without sound and doubles as the cover in search.","The 4 second minimum catches short loops exported for other networks, so pad anything briefer before uploading it.","Aim for 15 to 60 seconds on a video Pin. The 15 minute ceiling exists, but it is not where the saves come from."],faqs:[{question:"What size should a Pinterest Pin be?",answer:"1000 x 1500 pixels at 2:3. That is the ratio the feed is built around, and images taller than it are truncated rather than scaled down to fit."},{question:"What is the Pinterest image size limit?",answer:"20 MB per image, as JPG or PNG. Only TikTok photo posts match it, so a high quality export is worth uploading exactly as it is."},{question:"How long can a Pinterest video be?",answer:"Between 4 seconds and 15 minutes, at up to 2 GB. Most video Pins that perform sit between 15 and 60 seconds, so the ceiling is rarely worth using."},{question:"What aspect ratio works for Pinterest video?",answer:"9:16, 2:3, 4:5 and 1:1 are all accepted, and 9:16 at 1080 x 1920 fills the most space. Widescreen footage is letterboxed rather than rejected."},{question:"Do video Pins play with sound?",answer:"No, they autoplay muted in the feed. Anything the viewer needs to hear has to be on screen as text, and the first frame has to work as a still image."}],relatedToolSlugs:["pinterest-character-counter","social-media-video-size-checker","instagram-video-size-checker","tiktok-video-size-checker"]},"engagement-rate-calculator":{slug:"engagement-rate-calculator",family:"engagement-rate",platform:null,datePublished:T,lastUpdated:T,label:"Engagement rate calculator",metaTitle:"Engagement Rate Calculator (Free, 6 Networks)",metaDescription:"Free engagement rate calculator for Instagram, TikTok, Facebook, X, LinkedIn and YouTube. Get your rate, then compare it to benchmarks for your follower band.",heroEyebrow:"Free tool",heroTitle:"Engagement Rate Calculator",heroLead:"Work out your engagement rate in one step, then see where it lands against accounts your size: about 2.9% is the middle of the pack on Instagram at 1K to 10K followers, and 8.4% on TikTok.",intro:["An engagement rate on its own tells you almost nothing. A 2% rate is quietly excellent on Facebook, ordinary on Instagram and poor on TikTok, and the same number means something different again at 800 followers than it does at 800,000.","That is what this calculator adds. It runs the standard formula, (likes + comments) divided by followers times 100, and then puts your result next to the benchmark spread for your network and your follower band, so the number arrives with the context it needs.","The benchmarks are industry estimates aggregated from public studies, not measured data from your account. They are here to answer one question honestly: is this rate normal for an account like mine, or is something worth changing?"],tips:["Compare within your band before anything else. Median engagement drops at every size step on all six networks here, so a 1M account at 0.72% on Instagram is doing exactly as well as a 5K account at 2.9%.","Recalculate monthly, not after every post. One strong post can double a weekly average and tell you nothing you can repeat.","Leave boosted posts out of the average. Paid reach adds likes to the top of the formula without adding followers to the bottom, which flatters the rate and hides what organic is really doing.","A falling rate during fast follower growth is normal arithmetic, not a failure. New followers join the denominator immediately and take weeks to start engaging.","Audit the follower count itself once a year. Followers bought or won in a giveaway never engage, and they sit in the denominator forever."],faqs:[{question:"What is a good engagement rate on social media?",answer:"It depends entirely on the network and your size. Among accounts with 1K to 10K followers, the middle of the pack is roughly 8.4% on TikTok, 2.9% on Instagram, 2.85% on YouTube, 2.3% on LinkedIn, 0.8% on Facebook and 0.52% on X. Beating the median for your own band is the target that means something."},{question:"How do I calculate engagement rate?",answer:"Add your average likes and average comments across your last 10 to 12 organic posts, divide by your follower count, and multiply by 100. For an account with 8,000 followers averaging 210 likes and 18 comments: (210 + 18) / 8,000 x 100 = 2.85%."},{question:"Does reach or followers matter more?",answer:"Both are useful, for different jobs. Engagement by reach tells you how compelling a post was to the people who saw it, and it is the better diagnostic for a single post. Engagement by followers tells you how healthy the audience is overall, and it is the only version anyone else can verify, which is why published benchmarks use it. Track reach privately, report followers publicly."},{question:"Why is my engagement rate falling as I grow?",answer:"Because the denominator grows faster than attention does. Every network here falls at each step up in size: between the under 1K band and the 10K to 50K band the median at least halves on five of the six, and TikTok, the gentlest of them, still slides from about 10.2% to 7.3%. A rate that slips while your follower count climbs is usually a sign of growth, not decline."},{question:"Do saves, shares and views count toward engagement rate?",answer:"Not in this formula. They matter enormously for distribution, but every network reports them differently and some do not report them at all, so including them would make your rate impossible to compare with anyone else. Track them alongside your rate rather than inside it."},{question:"Is this engagement rate calculator free?",answer:"Yes. The calculation runs in your browser and nothing is sent anywhere. If you want the full percentile breakdown emailed to you, you can enter an address, but the benchmark tables on this page are free to read either way."}],relatedToolSlugs:["instagram-engagement-rate-calculator","tiktok-engagement-rate-calculator","linkedin-engagement-rate-calculator","best-time-to-post","social-media-character-counter"]},"instagram-engagement-rate-calculator":{slug:"instagram-engagement-rate-calculator",family:"engagement-rate",platform:"instagram",datePublished:T,lastUpdated:T,label:"Instagram engagement rate calculator",metaTitle:"Instagram Engagement Rate Calculator (Free)",metaDescription:"Calculate your Instagram engagement rate and compare it to accounts your size. Median is about 4.6% under 1K followers and 1.9% at 10K to 50K.",heroEyebrow:"Free Instagram tool",heroTitle:"Instagram Engagement Rate Calculator",heroLead:"Instagram engagement falls off a cliff as accounts grow: about 4.6% is typical under 1K followers, 2.9% at 1K to 10K, and 1.9% by the time you pass 10K.",intro:["Instagram is the network where engagement rate is quoted most and understood least. Rates published for the platform as a whole average together hobby accounts with 400 followers and brands with four million, which produces a number that describes nobody.","Broken out by size, the picture is clearer. Half of accounts under 1K sit above roughly 4.6%. In the 1K to 10K band that middle drops to about 2.9%, and above 10K it is closer to 1.9%. Each step up costs you roughly a third of your rate before you have changed anything about the content.","This calculator uses likes plus comments over followers, the version every benchmark study reports. Saves and shares are missing on purpose: they drive reach hard on Instagram, but the app only shows them to you, so no comparison built on them can be checked by anyone."],tips:["Judge Reels and feed posts separately before you average them. Reels reach far past your followers, which inflates likes against the same denominator, so mixing them hides how the feed is really performing.","Comments are worth more than likes for the same effort. Ending a caption with one specific question, then answering every reply in the first hour, reliably moves this number more than another hashtag set.","Ignore hashtag count as a lever here. Thirty tags do not raise engagement rate, and Instagram rejects the caption at thirty-one, so the ceiling is a limit rather than a target.","Watch the denominator, not just the numerator. Instagram never removes inactive followers for you, so an account that ran a giveaway two years ago is still paying for it in every rate it calculates.","Post carousels when you want comments. They earn multiple impressions per follower and give people something to react to on the last slide, which is where most carousel comments come from."],faqs:[{question:"What is a good engagement rate on Instagram?",answer:"It depends on your size. Under 1K followers, half of accounts are above roughly 4.6% and the top quartile starts near 7.8%. At 1K to 10K the median is about 2.9%, at 10K to 50K about 1.9%, and above a million about 0.72%. Anything above the median for your own band is a good result."},{question:"How do I calculate my Instagram engagement rate?",answer:"Take your last 10 to 12 organic posts, average the likes, average the comments, add the two averages together, divide by your follower count and multiply by 100. An account with 8,000 followers averaging 210 likes and 18 comments is at (210 + 18) / 8,000 x 100 = 2.85%."},{question:"Does reach or followers matter more on Instagram?",answer:"For a single post, reach is the sharper diagnostic: it tells you what happened with the people who actually saw it. For the account as a whole, followers is the honest measure, because reach on Instagram swings wildly with whether a Reel got picked up. Benchmarks are published by followers for exactly that reason."},{question:"Do saves and shares count toward Instagram engagement rate?",answer:"Not in this formula. Saves and shares are strong ranking signals and worth optimising for, but they are private metrics, so a rate that includes them cannot be compared against any published benchmark. Track them next to your rate instead of inside it."},{question:"Why did my Instagram engagement rate drop?",answer:"The most common reason is growth: new followers land in the denominator immediately and take weeks to start engaging. After that, look at the mix. A month heavy on Reels and light on carousels usually shows more reach and fewer comments, which reads as a drop even when the account is healthy."},{question:"Do Reels have a higher engagement rate than feed posts?",answer:"Usually yes on this formula, because Reels are shown to people who do not follow you while the denominator stays at your follower count. That is also why comparing a Reels-heavy month against a carousel-heavy one is unfair to the carousels."}],relatedToolSlugs:["instagram-character-counter","best-time-to-post-on-instagram","engagement-rate-calculator","instagram-video-size-checker"]},"tiktok-engagement-rate-calculator":{slug:"tiktok-engagement-rate-calculator",family:"engagement-rate",platform:"tiktok",datePublished:T,lastUpdated:T,label:"TikTok engagement rate calculator",metaTitle:"TikTok Engagement Rate Calculator (Free)",metaDescription:"Calculate your TikTok engagement rate by followers and compare it to your band. Median is about 10.2% under 1K followers and 7.3% at 10K to 50K.",heroEyebrow:"Free TikTok tool",heroTitle:"TikTok Engagement Rate Calculator",heroLead:"TikTok runs at least double every other network here, and further ahead the bigger the account: about 10.2% is typical under 1K followers, and even accounts past a million still sit near 4.6%.",intro:["TikTok engagement rates look wrong the first time you calculate one. Numbers that would be extraordinary on Instagram are ordinary here, because the For You feed shows your video to people who have never heard of you while the formula still divides by your follower count alone.","That is why TikTok deserves its own benchmark table. Half of accounts under 1K sit above roughly 10.2%. At 1K to 10K the middle is about 8.4%, at 10K to 50K about 7.3%, and even past a million followers the median is still around 4.6%, level with a typical Instagram account under 1K.","The decline with size is also gentler than anywhere else, because distribution on TikTok never depended on your follower count in the first place. Your audience size changes how many people the video starts with, not how far it can travel."],tips:["Treat watch time as the real lever. TikTok decides how far to push a video on completion and rewatch rate, and the likes and comments follow the reach rather than causing it.","Expect one viral video to distort a monthly average badly. Calculate with and without your best performer, and use the version without it to judge whether the baseline is moving.","Reply to comments with a video when a question repeats. It produces a second post from work you already did and reliably pulls more comments than a text reply.","Post the hook in the first two seconds, before anything else. Everything this calculator measures is downstream of whether people stayed.","If your rate is high but your follower count is flat, the videos are working and the profile is not. That is a bio and pinned-video problem, not an engagement problem."],faqs:[{question:"What is a good engagement rate on TikTok?",answer:"Higher than you would expect elsewhere. Under 1K followers the median is about 10.2% and the top quartile starts near 16.8%. At 1K to 10K the median is about 8.4%, at 10K to 50K about 7.3%, and above a million about 4.6%. The bottom quartile starts at 4.5% under 1K and is still 1.9% past a million, so falling under those is the signal to look at watch time."},{question:"How do I calculate my TikTok engagement rate?",answer:"Average the likes and comments across your last 10 to 12 videos, add the two averages, divide by your follower count and multiply by 100. Leave out anything you promoted, because paid views add likes without adding followers."},{question:"Should I calculate TikTok engagement by views instead of followers?",answer:"By views is useful for judging one video, since it tells you how the people who watched reacted. By followers is what benchmark studies publish and what this page compares you against. Views on TikTok can be twenty times your follower count one week and a fraction of it the next, so a by-views rate is too volatile to track as an account health metric."},{question:"Does reach or followers matter more on TikTok?",answer:"On TikTok, reach matters more for any single video, because the For You feed decides distribution almost independently of your follower count. Followers still matter as the stable denominator for tracking the account over time, which is why every published benchmark uses it."},{question:"Why is my TikTok engagement rate so much higher than my Instagram one?",answer:"Because TikTok shows your videos to non-followers by default and Instagram largely does not. The same content and the same audience will produce a rate roughly two to six times higher on TikTok, widening as the account grows, which is exactly why the two should never be compared against the same target."}],relatedToolSlugs:["tiktok-character-counter","best-time-to-post-on-tiktok","engagement-rate-calculator","tiktok-video-size-checker"]},"facebook-engagement-rate-calculator":{slug:"facebook-engagement-rate-calculator",family:"engagement-rate",platform:"facebook",datePublished:T,lastUpdated:T,label:"Facebook engagement rate calculator",metaTitle:"Facebook Engagement Rate Calculator (Free)",metaDescription:"Calculate your Facebook Page engagement rate and compare it to Pages your size. Median is about 1.3% under 1K fans and 0.52% at 10K to 50K.",heroEyebrow:"Free Facebook tool",heroTitle:"Facebook Engagement Rate Calculator",heroLead:"Facebook is the toughest room in this set: about 1.3% is a typical rate under 1K followers, 0.8% at 1K to 10K, and 0.14% for Pages past a million.",intro:["Facebook Page engagement rates read as catastrophic if you arrive from Instagram or TikTok. They are not. Organic reach on a Page has been a small fraction of its audience for years, so the same effort produces a fraction of the interactions against the same follower count.","Judged against Facebook itself, the picture is fair. Half of Pages under 1K followers sit above roughly 1.3%. At 1K to 10K the median is about 0.8%, at 10K to 50K about 0.52%, and above a million about 0.14%. Clearing 1% on a Page of any real size is genuinely strong.","Because the numbers are small, they move sharply. One post that catches a comment thread can double a monthly average, which is why an average across 10 to 12 posts is the only version worth tracking."],tips:["Chase comments rather than likes. Facebook keeps resurfacing a post while a conversation is still running under it, so a reply thread buys distribution that a like never will.","Post natively and stop sending people away. Link posts get less reach than the same idea written out in full with the link in the first comment.","Groups are where the engagement moved. If your Page rate is stuck at the floor, a Group around the same audience will usually outperform it several times over.","Check whether your follower count matches your actual audience. Pages that ran like-campaigns years ago carry followers who have not opened Facebook since, and they never leave the denominator.","Do not average boosted posts into your organic rate. On Facebook more than anywhere else, paid reach will quietly triple a number that is meant to describe organic health."],faqs:[{question:"What is a good engagement rate on Facebook?",answer:"Lower than on any other network here. Under 1K followers the median is about 1.3%. At 1K to 10K it is about 0.8%, at 10K to 50K about 0.52%, and above a million about 0.14%. Anything at or above 1% on a Page with real size is a strong result."},{question:"How do I calculate my Facebook engagement rate?",answer:"Average the likes and reactions plus the comments across your last 10 to 12 organic posts, divide by your Page follower count and multiply by 100. Reactions count as likes for this purpose, and boosted posts should be left out entirely."},{question:"Does reach or followers matter more on Facebook?",answer:"Reach is the more useful working number on Facebook, because organic reach is such a small share of followers that a by-followers rate mostly measures the algorithm rather than your content. Benchmarks are still published by followers, so use the by-followers rate to compare yourself against other Pages and reach to judge individual posts."},{question:"Why is my Facebook engagement rate so low?",answer:"Almost always organic reach rather than content quality. A typical Page post is shown to a small percentage of its followers, so even a post everyone would have liked only reaches a slice of them. Compare against the Facebook medians above rather than against your Instagram numbers."},{question:"Do shares count toward Facebook engagement rate?",answer:"Not in this formula, which uses likes and comments only so it can be compared with published benchmarks. Shares are the single strongest reach signal on Facebook though, so worth tracking separately as your best predictor of which posts will travel."}],relatedToolSlugs:["facebook-character-counter","best-time-to-post-on-facebook","engagement-rate-calculator","facebook-video-size-checker"]},"twitter-engagement-rate-calculator":{slug:"twitter-engagement-rate-calculator",family:"engagement-rate",platform:"twitter",datePublished:T,lastUpdated:T,label:"X engagement rate calculator",metaTitle:"X (Twitter) Engagement Rate Calculator (Free)",metaDescription:"Calculate your X engagement rate by followers and compare it to accounts your size. Median is about 0.85% under 1K followers and 0.33% at 10K to 50K.",heroEyebrow:"Free X tool",heroTitle:"X (Twitter) Engagement Rate Calculator",heroLead:"X produces the smallest numbers of any network here: about 0.85% under 1K followers, 0.52% at 1K to 10K, and 0.09% for accounts past a million.",intro:["Engagement rate on X is calculated two completely different ways, and mixing them up is why the numbers people quote never agree. The in-app analytics divide by impressions, which produces a friendly figure. Published benchmarks divide by followers, which produces a much smaller one.","This calculator uses the by-followers version so the comparison holds. On that basis, half of accounts under 1K sit above roughly 0.85%. At 1K to 10K the median is about 0.52%, at 10K to 50K about 0.33%, and past a million about 0.09%.","The reason the numbers are small is timeline speed. A post has a short window before it is buried, and only a fraction of your followers are online in it. That makes volume matter more on X than on any other network in this set."],tips:["Do not compare your in-app engagement rate to these figures. X reports engagement over impressions, which routinely shows several percent for the same post that scores a fraction of one percent here.","Replies are the engagement that compounds. A post ending in a question or a genuine disagreement gets pulled back into timelines in a way that a post ending in a link never does.","Post more often than feels natural. The same idea at three different hours reaches three mostly different slices of your followers, and none of them saw the other two.","Keep the link out of the first post. Posts that send people off the platform are shown less, so a thread with the link at the end usually outperforms the same content with the link at the top.","Quote your own older post rather than reposting it. It reads as a new post to the timeline and gives your followers a reason to engage twice."],faqs:[{question:"What is a good engagement rate on X?",answer:"By followers, under 1K the median is about 0.85% and the top quartile starts near 1.8%. At 1K to 10K the median is about 0.52%, at 10K to 50K about 0.33%, and above a million about 0.09%. Consistently above 1% at any real size puts you well ahead."},{question:"How do I calculate my X engagement rate?",answer:"Average the likes and the replies across your last 10 to 12 posts, add them together, divide by your follower count and multiply by 100. Use organic posts only, and skip any post that was promoted."},{question:"Why is my X analytics engagement rate so much higher?",answer:"Because X divides by impressions rather than followers. That answers a different question: how compelling the post was to people who saw it, not how engaged your audience is. Both are useful, but only the by-followers version can be compared against published benchmarks."},{question:"Does reach or followers matter more on X?",answer:"Impressions are the better measure of a single post on X, since timing decides so much of who sees it. Followers is the better measure of the account over time, because impressions swing enormously between posts and cannot be verified by anyone outside the account."},{question:"Do reposts and bookmarks count toward engagement rate?",answer:"Not in this formula. It uses likes and replies so the result matches how benchmarks are published. Reposts are the strongest distribution signal on X and bookmarks are the strongest quality signal, so both are worth tracking on their own."}],relatedToolSlugs:["twitter-character-counter","best-time-to-post-on-twitter","engagement-rate-calculator","twitter-video-size-checker"]},"linkedin-engagement-rate-calculator":{slug:"linkedin-engagement-rate-calculator",family:"engagement-rate",platform:"linkedin",datePublished:T,lastUpdated:T,label:"LinkedIn engagement rate calculator",metaTitle:"LinkedIn Engagement Rate Calculator (Free)",metaDescription:"Calculate your LinkedIn engagement rate and compare it to pages and profiles your size. Median is about 3.2% under 1K followers and 1.6% at 10K to 50K.",heroEyebrow:"Free LinkedIn tool",heroTitle:"LinkedIn Engagement Rate Calculator",heroLead:"LinkedIn rewards smaller audiences generously: about 3.2% is typical under 1K followers, 2.3% at 1K to 10K, and 1.6% once you pass 10K.",intro:["LinkedIn lands mid-pack in this set, behind TikTok, Instagram and YouTube but comfortably clear of Facebook and X, which is a fair result for a network with no For You feed pushing you to strangers. What LinkedIn has instead is patience: a post stays in circulation for days rather than hours, so engagement keeps accumulating long after the post stopped being new.","Half of accounts under 1K followers sit above roughly 3.2%. At 1K to 10K the median is about 2.3%, at 10K to 50K about 1.6%, and above a million about 0.52%. Personal profiles typically run ahead of company pages at the same size, so a page clearing its band median is doing well.","The long tail also changes how you measure. A post can still be collecting comments a week later, so leave your most recent two or three posts out of the average until they have finished running."],tips:["Answer every comment inside the first two hours. On LinkedIn that window decides how far the post travels, and replies count as engagement in their own right.","Put the whole idea in the post. Text that sends people to an external link is shown to fewer of your followers than the same argument written out in full.","Post from people, not only from the page. Employee posts consistently out-engage the company page covering the same news, which is why the two should be measured separately.","Front-load the first two lines. LinkedIn folds the rest behind a see more link, and the decision to expand is the decision to engage.","Do not post daily just to post. LinkedIn distribution decays slowly, so posting on top of a post that is still working splits the same audience across both."],faqs:[{question:"What is a good engagement rate on LinkedIn?",answer:"Under 1K followers, the median is about 3.2% and the top quartile starts near 6.1%. At 1K to 10K the median is about 2.3%, at 10K to 50K about 1.6%, and above a million about 0.52%. LinkedIn benchmarks run high compared to Facebook or X, so aim at your band rather than at a round number."},{question:"How do I calculate my LinkedIn engagement rate?",answer:"Average the reactions and the comments across your last 10 to 12 posts, add the two averages, divide by your follower or connection count and multiply by 100. Leave out posts from the last few days, because LinkedIn posts keep collecting engagement for a week or more."},{question:"Does reach or followers matter more on LinkedIn?",answer:"Impressions are useful for spotting which topics travel beyond your network, since LinkedIn shows strong posts to second-degree connections. Followers is the number to track over time and the one all published benchmarks use, so keep both and report the by-followers version."},{question:"Do company pages have lower engagement rates than personal profiles?",answer:"Generally yes, at the same audience size. LinkedIn favours posts from people, so a page and a founder posting the same update will usually see the founder outperform. Compare pages against pages when you can, and treat the band medians here as the floor for a profile and a fair target for a page."},{question:"Why did my LinkedIn engagement rate drop after posting more often?",answer:"Because LinkedIn keeps older posts alive for days. Publishing daily means each new post competes with your own previous one for the same followers, and the totals split rather than add up. Fewer, stronger posts usually raise the rate."}],relatedToolSlugs:["linkedin-character-counter","best-time-to-post-on-linkedin","engagement-rate-calculator","linkedin-video-size-checker"]},"youtube-engagement-rate-calculator":{slug:"youtube-engagement-rate-calculator",family:"engagement-rate",platform:"youtube",datePublished:T,lastUpdated:T,label:"YouTube engagement rate calculator",metaTitle:"YouTube Engagement Rate Calculator (Free)",metaDescription:"Calculate your YouTube engagement rate by subscribers and compare it to channels your size. Median is about 4.1% under 1K subscribers and 2.05% at 10K to 50K.",heroEyebrow:"Free YouTube tool",heroTitle:"YouTube Engagement Rate Calculator",heroLead:"Measured against subscribers, about 4.1% is typical for channels under 1K, 2.85% at 1K to 10K, and 2.05% once you pass 10K subscribers.",intro:["YouTube is the one network where the subscriber count is genuinely a weak denominator. Search and suggested videos deliver most views on a healthy channel, and plenty of those viewers never subscribe, so a rate by subscribers describes the relationship with your audience rather than the reach of your videos.","It is still worth tracking, because it is comparable. Half of channels under 1K subscribers sit above roughly 4.1%. At 1K to 10K the median is about 2.85%, at 10K to 50K about 2.05%, and above a million about 0.7%.","Track it next to engagement by views, which on YouTube is the sharper number for a single upload. If your rate by subscribers is falling while your rate by views holds, you are reaching new people, which is exactly what you want."],tips:["Pin a comment that asks something specific. The comment section is the engagement engine on YouTube, and a pinned prompt reliably lifts the reply count on the same video.","Keep Shorts and long-form in separate averages. Shorts collect views and likes from people who will never subscribe, so mixing them makes both numbers meaningless.","Ask for the like once, at the moment the video has just delivered something useful. Asking in the first ten seconds, before you have earned it, does nothing.","Look at the ratio of comments to likes as well as the rate itself. A high like count with almost no comments usually means the video was agreeable but not interesting.","Use the community tab between uploads. It engages subscribers directly, and on a channel that uploads weekly it can move the monthly rate noticeably."],faqs:[{question:"What is a good engagement rate on YouTube?",answer:"Measured against subscribers, under 1K the median is about 4.1% and the top quartile starts near 7.5%. At 1K to 10K the median is about 2.85%, at 10K to 50K about 2.05%, and above a million about 0.7%. Larger channels sit lower because search and suggested traffic outgrows the subscriber base."},{question:"How do I calculate my YouTube engagement rate?",answer:"Average the likes and the comments across your last 10 to 12 uploads, add them together, divide by your subscriber count and multiply by 100. Keep Shorts out of the same average as long-form videos, because they behave completely differently."},{question:"Should I calculate YouTube engagement by views or subscribers?",answer:"Both, for different jobs. By views tells you how a specific video landed with the people who watched it, which is the better editorial signal. By subscribers is what benchmark studies publish and what this page compares you against, so it is the version to use when you want to know whether the channel is normal for its size."},{question:"Does reach or subscribers matter more on YouTube?",answer:"Views matter more for growth, since most of a healthy channel comes from search and suggested rather than the subscriptions feed. Subscribers matter as the stable denominator that makes your number comparable, and as the audience that shows up in the first hour, which is what tells the algorithm the video is worth pushing."},{question:"Why is my YouTube engagement rate falling as the channel grows?",answer:"Because subscribers accumulate permanently while attention does not. Someone who subscribed for one video two years ago still counts in the denominator forever. Every band above yours shows the same pattern, so compare against your own size band rather than against your own history."}],relatedToolSlugs:["youtube-character-counter","best-time-to-post-on-youtube","engagement-rate-calculator","youtube-video-size-checker"]},"sponsored-post-rate-calculator":{slug:"sponsored-post-rate-calculator",family:"creator-rate",platform:null,datePublished:v,lastUpdated:v,label:"Sponsored post rate calculator",metaTitle:"Sponsored Post Rate Calculator (Free Influencer Rates)",metaDescription:"Free sponsored post rate calculator for 6 networks. Enter followers, likes and comments to estimate what one post is worth, plus rate ranges for every follower band.",heroEyebrow:"Free tool",heroTitle:"Sponsored Post Rate Calculator",heroLead:"Work out what to charge for one sponsored post. An Instagram account at 10K to 50K followers with average engagement sits around $300 to $1,000, and top quartile engagement moves that to $405 to $1,350.",intro:["Most creators pick their first sponsored post rate by guessing, then find out months later that the brand had budgeted three times what they asked for. There is no public price list, every contract is private, and the one creator willing to tell you their number usually works in a different niche at a different size.","This influencer rate calculator gives you a defensible starting figure instead. Your follower count puts you in one of six bands, each with a typical range per post on the network you pick. Your engagement rate then moves that range up or down, because an audience that reacts is the thing a brand is actually buying. Top quartile engagement prices about a third above the middle of the market, and a rate under the 25th percentile prices about 15% below it.","Everything here is an estimate built from public creator pricing surveys, agency rate cards and marketplace listings. It is not measured data from your account, and not from any other account either. Treat the result as the bracket to negotiate inside rather than a fixed price: your niche, your deliverables and the usage rights a brand asks for can move the final number a long way in either direction."],tips:["Send a range, never a single number. Quoting one figure means the only direction the conversation can move is down. A range lets you attach the top of it to the deliverables you actually want to produce.","Do not name a price in your first reply. Ask what the brief is, how many assets they need, how long they want to use them, and whether they expect exclusivity. Half the value in a deal lives in those four answers, and quoting before you have them means giving that half away.","Keep a one-page media kit current and send it within the hour. Audience size, engagement rate, your three best posts, audience location and age split, and your rate ranges. Brands negotiate differently with a creator who answers like a business.","Price usage rights separately, every time. A brand that wants to run your post as a paid ad is buying media, not content. A common structure is the organic rate plus 25% to 50% per month of paid usage, written into the agreement rather than assumed.","Charge for exclusivity by the length of the window and the width of the category. Three months of turning down competing brands in your main category is normally worth 20% to 30% on top of the fee, and a full year should cost more than the post itself.","Quote per deliverable, then discount the bundle on purpose. Three posts and two stories should not come to three times your post rate by accident. Add up the individual rates, then take a visible 10% to 15% off so the discount reads as a concession you chose to make."],faqs:[{question:"How is my sponsored post rate calculated?",answer:"In two steps. Your follower count puts you in one of six bands, and each band has a typical rate range on the network you selected. Your engagement rate, calculated as (likes + comments) divided by followers times 100, is then compared against benchmarks for that same band, and the range is multiplied by 0.85 below the 25th percentile, 1.0 around the median, 1.15 above it and 1.35 in the top quartile. Both the band ranges and the engagement benchmarks are estimates aggregated from public industry studies, agency rate cards and marketplace listings."},{question:"Why does engagement matter more than follower count?",answer:"Because followers are what a brand can see and engagement is what a brand is buying. Two accounts at 40K followers can differ by ten times in comments per post, and the one that gets replies is the one whose audience will click a link or remember a name. Follower count sets the bracket you are quoted in, engagement decides where inside that bracket you land, which is why a strong small account routinely out-earns a bigger quiet one on cost per action."},{question:"Do I get the full rate breakdown?",answer:"Yes, by email. The per-post estimate and every rate table on this page are free to read with no address at all. The full media kit breakdown, with each format priced and the engagement adjustment explained, unlocks when you ask us to send it, and the emailed version uses exactly the same public estimates you see here. There is no paid tier and no extra data behind the form."},{question:"What is a media kit?",answer:"A one-page summary a brand can forward internally without asking you follow-up questions. It carries your handle and niche, follower count per network, engagement rate, two or three example posts with their results, an audience breakdown by country and age, and your rate ranges by deliverable. It exists so the person who likes your work can sell you to the person holding the budget."},{question:"Is my data stored?",answer:"The calculation runs entirely in your browser and nothing leaves the page while you type. We receive something only if you ask for the report by email, and then it is your address, the figures you entered and which page you were on, so we can send the report and know which tool produced it. Marketing email is a separate checkbox that starts unticked."},{question:"What if a brand offers free product instead of money?",answer:"Gifting is fair at the smallest sizes and gets expensive fast above them, because you are still doing the shoot, the edit and the caption. A workable rule is to accept product only when its retail value clears your rate for that deliverable, and to say yes to gifting once with a brand you like, then quote normally for anything after that."}],relatedToolSlugs:["engagement-rate-calculator","instagram-money-calculator","tiktok-money-calculator","youtube-money-calculator","best-time-to-post"]},"instagram-money-calculator":{slug:"instagram-money-calculator",family:"creator-rate",platform:"instagram",datePublished:v,lastUpdated:v,label:"Instagram money calculator",metaTitle:"Instagram Money Calculator (Free Sponsored Post Rates)",metaDescription:"Free Instagram money calculator. Estimate what one sponsored post is worth from your followers and engagement, with rate ranges for all six follower bands.",heroEyebrow:"Free Instagram tool",heroTitle:"Instagram Money Calculator",heroLead:"Estimate what one sponsored Instagram post is worth. Accounts at 10K to 50K followers with average engagement land around $300 to $1,000 per post, and top quartile engagement prices about a third higher.",intro:["An Instagram money calculator can mean two very different things: what Instagram pays you, or what a brand pays you to post. Instagram itself pays creators very little directly. Bonus programs have come and gone, gifts and subscriptions reach a narrow slice of accounts, and none of it scales with how good your audience is. The real money on Instagram is sponsorship money, and that is what this page estimates.","It works from two numbers you already have. Your follower count puts you in one of six bands, each with a typical range per sponsored post. Your average likes and comments then adjust that range, because a 30K account pulling 3% engagement is worth noticeably more to a brand than a 30K account sitting at 0.6%, and every buyer with a media budget knows it.","The ranges cover one organic feed post or Reel, single network, no exclusivity and no paid usage rights. Stories price lower, at roughly 45% of a feed post, and a sponsored Reel prices higher. Every figure is an estimate aggregated from public creator pricing surveys, agency rate cards and marketplace listings, not measured data from your account."],tips:["Put your engagement rate in the pitch, not just your follower count. Instagram engagement falls at every size step, so a 25K account holding 3% is beating the median for its band by a wide margin and should be paid like it.","Quote feed posts, Reels and stories as separate line items. A brand asking for a Reel plus three story frames is asking for three shoots, and a single blended number lets them add frames later for free.","Ask for the usage rights up front. Whitelisting, where the brand runs your post from their own ad account, is the request most likely to arrive after the fee is agreed. Price it at 25% to 50% of the organic rate per month of paid usage.","Set an exclusivity clock and charge for it. Category exclusivity for three months is worth 20% to 30% on top, and anything longer than six months should be priced as if you were turning down a second deal, because you are.","Keep a media kit with your last three top posts by saves and shares, not just likes. Those two metrics drive Instagram reach, and showing them tells a brand your reach is earned rather than bought.","Never accept the first budget number a brand names. Agencies open below their ceiling by default, and a single polite counter that references your engagement rate and the deliverable list is the highest paid minute of the whole negotiation."],faqs:[{question:"How is my Instagram sponsored post rate calculated?",answer:"Your follower count puts you in one of six bands, each with a typical Instagram rate range: roughly $25 to $80 under 1K, $80 to $300 at 1K to 10K, $300 to $1,000 at 10K to 50K, and up from there. Your engagement rate, (likes + comments) divided by followers times 100, is compared against Instagram benchmarks for that band, and the range is then multiplied by 0.85, 1.0, 1.15 or 1.35 depending on where you land. All of it is estimated from public pricing surveys and agency rate cards, not from Instagram data."},{question:"Why does engagement matter more than follower count on Instagram?",answer:"Because Instagram reach stopped tracking follower count years ago. Two accounts at 40K can differ by five times in comments per post, and the one with a live comment section is the one whose audience will actually act on a recommendation. Followers decide which bracket a brand quotes you in, engagement decides where inside that bracket you land."},{question:"Does Instagram pay creators directly?",answer:"Barely, and not predictably. Bonus programs have been launched and shut down repeatedly, subscriptions only work if you already have a paying audience, and gifts are small. For almost every creator the income is brand deals plus affiliate links, which is why this calculator estimates sponsored post value rather than a payout from Instagram."},{question:"Do I get the full media kit breakdown?",answer:"Yes, by email. The headline estimate and all the rate tables on this page are free with no address. The full breakdown, with the feed post, story and Reel rates side by side and the engagement adjustment explained, unlocks when you ask us to send it, and the emailed version uses exactly the same public estimates shown here."},{question:"What is a media kit and do I need one for Instagram?",answer:"It is a one-page PDF a brand can forward without asking you anything else: handle and niche, follower count, engagement rate, two or three example posts with results, an audience breakdown by country and age, and your rate ranges per deliverable. Above about 10K followers, brands expect one, and not having it usually costs you the deal to a creator who does."},{question:"Is my data stored?",answer:"No, unless you ask for the emailed report. The calculation runs in your browser and nothing is sent while you type. If you request the report we receive your address, the numbers you entered and the page slug, purely to deliver it. Marketing email is a separate checkbox that starts unticked."}],relatedToolSlugs:["instagram-engagement-rate-calculator","sponsored-post-rate-calculator","tiktok-money-calculator","instagram-character-counter","best-time-to-post-on-instagram"]},"tiktok-money-calculator":{slug:"tiktok-money-calculator",family:"creator-rate",platform:"tiktok",datePublished:v,lastUpdated:v,label:"TikTok money calculator",metaTitle:"TikTok Money Calculator (Free Brand Deal Rates)",metaDescription:"Free TikTok money calculator. Estimate what a sponsored video is worth from your followers and engagement, with brand deal rate ranges for every follower band.",heroEyebrow:"Free TikTok tool",heroTitle:"TikTok Money Calculator",heroLead:"Estimate what one sponsored TikTok is worth. A 10K to 50K account with average engagement sits around $280 to $950 per video, and brand deals pay far more than the creator payouts TikTok runs itself.",intro:["Almost everyone searching for a TikTok money calculator is trying to answer one of two questions: what TikTok pays per view, or what a brand should pay for a sponsored video. The first answer is disappointing and the second is where the income actually is, so this page estimates sponsorship value from your followers and your engagement.","TikTok prices slightly under Instagram at nano and micro sizes, where buyers still quote off follower count, then overtakes it from around 50K up, where a video that travels beyond your followers is worth more than a feed post that does not. Engagement is the adjustment on top: TikTok rates run high across the board, so a rate that would be excellent on Instagram can sit below the 25th percentile here.","Every figure covers one organic video, single network, no exclusivity and no Spark Ads usage. They are estimates aggregated from public creator pricing surveys, agency rate cards and marketplace listings, not measured data from your account or from TikTok."],tips:["Quote against your median video, not your best one. One clip at four million views does not raise your rate, and a brand that checks your last ten videos will notice the gap immediately.","Price Spark Ads usage as a separate line. Letting a brand run your video as an ad from their account is media buying, and 25% to 50% of the organic fee per month is the normal ask.","Charge for the number of revisions, or cap them at two in writing. TikTok briefs turn into reshoot requests more often than any other network, and an uncapped revision loop quietly halves your effective rate.","Ask for a category exclusivity window in months and price it. Thirty to ninety days of turning down competing brands is worth 20% to 30% on top of the fee, and TikTok brands ask for it more aggressively than most.","Build a media kit around watch time and completion rate, not just followers. Those are the numbers TikTok rewards and the ones a paid media buyer understands, and showing them justifies the top of your range.","Bundle a stitch or a reply video into bigger deals rather than discounting the main video. It costs you a fraction of the effort and gives the brand a second asset to point at when the budget is reviewed."],faqs:[{question:"How is my TikTok sponsored video rate calculated?",answer:"Your follower count sets the band: roughly $20 to $65 under 1K, $65 to $260 at 1K to 10K, $280 to $950 at 10K to 50K, and up from there. Your engagement rate, (likes + comments) divided by followers times 100, is compared against TikTok benchmarks for that same band, and the range is multiplied by 0.85 below the 25th percentile, 1.0 around the median, 1.15 above it and 1.35 in the top quartile. All of it is estimated from public pricing surveys and agency rate cards."},{question:"Is this the TikTok Creator Fund calculator?",answer:"No. This estimates what a brand pays you for a sponsored video, which is where nearly all creator income on TikTok comes from. The creator payouts TikTok runs itself are paid per qualified view on longer videos and typically work out to single-digit dollars per hundred thousand views, so one mid-size brand deal can be worth more than a month of them."},{question:"Why does engagement matter more than follower count on TikTok?",answer:"Because the For You feed decides your reach, not your follower list. A 20K account whose videos hold people to the end can out-deliver a 200K account that people scroll past, and brands that buy on cost per view have learned this. Followers set the bracket you are quoted in, engagement decides where inside it you land."},{question:"Do I get the full rate breakdown?",answer:"Yes, by email. The headline estimate and every rate table on this page are free with no address. The full breakdown, with the engagement adjustment explained and negotiation notes attached, unlocks when you ask us to send it, and the emailed version uses exactly the same public estimates shown here."},{question:"What is a media kit and does TikTok need one?",answer:"It is a one-page summary a brand can forward internally: handle and niche, follower count, engagement rate, two or three videos with their view and completion numbers, audience breakdown by country and age, and your rates per deliverable. On TikTok it matters more than elsewhere, because your follower count understates your reach and the media kit is where you prove it."},{question:"Is my data stored?",answer:"Only if you ask for the emailed report. The calculation runs in your browser and nothing is sent while you type. Requesting the report sends us your address, the numbers you entered and which page you were on, so we can deliver it. Marketing email is a separate, unticked checkbox."}],relatedToolSlugs:["tiktok-engagement-rate-calculator","sponsored-post-rate-calculator","instagram-money-calculator","tiktok-character-counter","best-time-to-post-on-tiktok"]},"youtube-money-calculator":{slug:"youtube-money-calculator",family:"creator-rate",platform:"youtube",datePublished:v,lastUpdated:v,label:"YouTube money calculator",metaTitle:"YouTube Money Calculator (Free Sponsorship Rates)",metaDescription:"Free YouTube money calculator for brand deals. Estimate what a sponsored video is worth from your subscribers and engagement. AdSense revenue is not included.",heroEyebrow:"Free YouTube tool",heroTitle:"YouTube Money Calculator",heroLead:"Estimate what a sponsorship is worth on your channel. A 10K to 50K subscriber channel with average engagement sits around $800 to $3,000 per dedicated video. AdSense is a separate income stream and is not estimated here.",intro:["YouTube is the most expensive network in this set at every channel size, and the reason is simple: a sponsored video is production work, not a caption. Scripting, filming, editing and integrating a brand message into something an audience chose to watch for ten minutes is a different job from posting a photo, and rates reflect that.","This calculator estimates sponsorship value only. It takes your subscriber count, which puts you in one of six bands, then adjusts the band range by your engagement rate against benchmarks for channels the same size. Subscribers are a weak denominator on YouTube, since search and suggested deliver most views on a healthy channel, so the engagement adjustment is doing real work here.","AdSense revenue is deliberately not part of this. Ad income depends on watch time, RPM and your audience country rather than on subscribers, it varies enormously by niche, and mixing it into a sponsorship estimate would make both numbers useless. Everything below is an estimate aggregated from public creator pricing surveys, agency rate cards and marketplace listings."],tips:["Quote off your average views for the last ten uploads, then use the subscriber band as your floor. On YouTube more than anywhere, a brand is buying the views, and a channel that consistently beats its subscriber count should say so in the first email.","Price a dedicated video and an integration as different products. A 60 to 90 second integration inside your own video is a fraction of the work of a full dedicated review, and quoting one number for both means you will be asked for the expensive one.","Charge separately for the description link, the pinned comment and any end screen. They are cheap to give and easy to forget, and bundling them into the base fee removes three things you could have traded later.","Put a revision cap and an approval deadline in writing. Sponsor review on YouTube can stall an upload for weeks, and a clause that releases the video after a fixed review window protects your schedule and your rate.","Sell exclusivity by category and by window. Ninety days of no competing sponsors is worth 20% to 30% on top of the fee, and any brand asking for a year in a competitive category should expect to pay a multiple.","Keep a media kit with average views, average view duration, subscriber count and audience country split. Average view duration is the number that separates a channel worth sponsoring from one that only looks big."],faqs:[{question:"How is my YouTube sponsorship rate calculated?",answer:"Your subscriber count sets the band: roughly $50 to $200 under 1K, $200 to $800 at 1K to 10K, $800 to $3,000 at 10K to 50K, and up from there for a dedicated video. Your engagement rate, (likes + comments) divided by subscribers times 100, is compared against YouTube benchmarks for the same band, and the range is multiplied by 0.85 below the 25th percentile, 1.0 around the median, 1.15 above it and 1.35 in the top quartile. Every figure is estimated from public pricing surveys and agency rate cards."},{question:"Does this include AdSense revenue?",answer:"No. This calculator estimates brand sponsorship value only. AdSense pays on watch time and RPM, which swing by niche and by audience country far more than by subscriber count, so it is a separate income stream that has to be estimated separately. Most channels in the mid bands earn more from one sponsored video than from a month of ad revenue, but the two should never be added together from the same inputs."},{question:"Why does engagement matter more than subscriber count?",answer:"Because subscribers accumulate permanently and attention does not. Someone who subscribed for one video three years ago still counts, which is why a channel with 40K engaged subscribers can be worth more to a brand than one with 200K dormant ones. Subscribers set the bracket you are quoted in, engagement and average views decide where inside that bracket you land."},{question:"Do I get the full rate breakdown?",answer:"Yes, by email. The headline estimate and all the rate tables on this page are free with no address. The full breakdown, with the dedicated video and Short rates side by side and the engagement adjustment explained, unlocks when you ask us to send it, and the emailed version uses exactly the same public estimates shown here."},{question:"What is a media kit for a YouTube channel?",answer:"A one-page summary a brand can forward internally: channel name and niche, subscriber count, average views and average view duration over the last ten uploads, engagement rate, audience split by country and age, and your rates for a dedicated video, an integration and a Short. Average view duration is the line sponsors read first."},{question:"Is my data stored?",answer:"Only when you ask for the emailed report. The calculation runs in your browser and nothing leaves the page while you type. Requesting the report sends us your address, the numbers you entered and which page you were on, purely so we can deliver it. Marketing email is a separate checkbox that starts unticked."}],relatedToolSlugs:["youtube-engagement-rate-calculator","sponsored-post-rate-calculator","instagram-money-calculator","youtube-character-counter","best-time-to-post-on-youtube"]},"best-time-to-post":{slug:"best-time-to-post",family:"best-time",platform:null,datePublished:y,lastUpdated:y,label:"Best time to post",metaTitle:"Best Time to Post on Social Media (2026)",metaDescription:"Best times to post on 8 networks, with an hour by hour heatmap for each. LinkedIn peaks Tuesday 10:00, Facebook Wednesday 13:00, Instagram 19:00, TikTok 20:00.",heroEyebrow:"Free tool",heroTitle:"Best Time to Post on Social Media",heroLead:"There is no single best hour. LinkedIn peaks Tuesday at 10:00, Facebook at 13:00, X around midday, Instagram at 19:00 and TikTok at 20:00, which is five different schedules in one week.",intro:["Every best time to post list you have read averages eight networks into one answer, and the answer always lands somewhere in the middle of the working day. That number describes none of the networks it came from.","Split them apart and the pattern is obvious. LinkedIn lives in the weekday morning window, 09:00 to 11:00, and dies after 18:00. Facebook owns the working day, 10:00 to 14:00, and fades every evening. X peaks around midday with a second wind in the late afternoon. Instagram, Threads, TikTok, YouTube and Pinterest all belong to the evening, from 19:00 through to 21:00.","Wednesday holds the strongest single slot on six of the eight networks here, with LinkedIn and X peaking on Tuesday instead. The weekend is where they split hardest: LinkedIn drops to under a third of its midweek level, while Pinterest and YouTube are at their best.","The heatmaps below are the whole dataset, hour by hour, free to read. If you want the version tuned to your niche and laid out as a seven day plan, the planner does that."],tips:["Pick one slot per network and keep it for a month before judging it. A slot you hit every week beats a better slot you hit occasionally, because your audience learns the rhythm.","Post on your audience local time, not yours. These grids are audience-local: if you are in Berlin and your audience is in New York, a 19:00 slot means 19:00 for them, which is the middle of your night and exactly what scheduling is for.","Watch the first hour. Most networks decide how far to push a post from the reaction it gets early, so being around to answer the first few comments is worth more than shifting the slot by thirty minutes.","Test one change at a time. Move the hour or move the day, never both, and give each version at least three posts before deciding.","When your own analytics disagree with this page, your analytics win. These are aggregated starting points, and a real audience of your own beats an estimate every time."],faqs:[{question:"What is the best time to post on social media?",answer:"It depends entirely on the network. On the estimates here, LinkedIn peaks Tuesday at 10:00, Facebook Wednesday at 13:00, X on Tuesday around 12:00, Instagram Wednesday at 19:00, Threads, TikTok and YouTube at 20:00, and Pinterest at 21:00. No single hour serves more than two of them at once."},{question:"What is the best day to post?",answer:"Wednesday holds the strongest single slot on six of the eight networks here: Instagram, Facebook, Threads, TikTok, YouTube and Pinterest. LinkedIn and X peak on Tuesday, with Wednesday level a hair behind. Measured across the whole day rather than one hour, YouTube and Pinterest are strongest at the weekend instead, and Friday is the weakest weekday almost everywhere."},{question:"Is it better to post in the morning or the evening?",answer:"Morning for the professional networks, evening for everything else. LinkedIn between 09:00 and 11:00 is the clearest morning window in this dataset, and Facebook and X both do their best work before 14:00. Instagram, Threads, TikTok, YouTube and Pinterest are all evening networks, and posting to them at 09:00 gives up most of their audience."},{question:"Should I post at the weekend?",answer:"On some networks, yes. Pinterest and YouTube both score higher across a weekend day than on any weekday, TikTok weekends add up to more than a Monday, and Instagram on Sunday evening matches a Monday. LinkedIn is the opposite: a whole Saturday adds up to less than a third of a Wednesday, so it is the one network where skipping the weekend costs you nothing."},{question:"Does posting time still matter in 2026?",answer:"Less than it did, but it still matters. Recommendation feeds have loosened the link between the minute you post and who sees it, especially on TikTok and Instagram Reels. What has not changed is that every network still has hours when far more people are looking, and posting into those hours gives the algorithm more early signal to work with."},{question:"How were these times worked out?",answer:"They are aggregated engagement patterns: published posting-time studies, the daily rhythms each platform reports about its own audience, and how the apps are actually used, scored 0 to 100 per hour within each network. They are estimates reviewed in July 2026, not measurements of any individual account, and no personal data goes into them."}],relatedToolSlugs:["best-time-to-post-on-instagram","best-time-to-post-on-linkedin","best-time-to-post-on-tiktok","engagement-rate-calculator","social-media-character-counter"]},"best-time-to-post-on-instagram":{slug:"best-time-to-post-on-instagram",family:"best-time",platform:"instagram",datePublished:y,lastUpdated:y,label:"Best time to post on Instagram",metaTitle:"Best Time to Post on Instagram (2026 Guide)",metaDescription:"Instagram peaks Wednesday at 19:00, with the weekday evening window running 18:00 to 20:00. See the full hour by hour heatmap and build a weekly plan.",heroEyebrow:"Free Instagram tool",heroTitle:"Best Time to Post on Instagram",heroLead:"Instagram peaks in the evening, not at lunch: Wednesday at 19:00 is the single strongest slot, inside a weekday window that runs from 18:00 to 20:00.",intro:["The advice to post on Instagram at 11:00 has outlived the app it was written for. There is still a real lunch rise, roughly 11:00 to 13:00, but it tops out below where the evening starts: on a midweek day the 12:00 peak sits under the 18:00 level and well under 19:00.","The evening window is where the network actually is. Attention climbs from 17:00, passes lunch by 18:00, peaks at 19:00, and holds through 20:00 before dropping away after 21:00. Wednesday at 19:00 is the strongest cell in the grid, with Tuesday and Thursday a point behind and Friday noticeably softer.","Weekends are flatter rather than worse. Saturday holds a long plateau from midday to about 20:00, so the exact minute matters less, and Sunday evening comes back to weekday strength at 19:00. If you post five days a week the weekday evenings earn the slots, and if you post seven, Sunday evening is the weekend one worth keeping."],tips:["Take the 18:00 to 20:00 window, pick one hour inside it, and keep it. Instagram rewards a rhythm your followers can learn more than it rewards a perfect hour you hit once.","Be there for the first hour. Replying to early comments while the post is still being distributed is the cheapest way to extend its run, and it is why a 19:00 slot beats a 22:00 one even when both look fine on paper.","Reels and feed posts can share the same window. Reels travel past your followers either way, but a strong first hour still helps them start, so there is no reason to move them out of the evening.","Set the schedule on your audience time zone, not your own. Instagram shows you where your followers are, and these hours are theirs.","Give any change three weeks. Instagram engagement swings enough week to week that a single quiet Wednesday says nothing about the slot."],faqs:[{question:"What is the best time to post on Instagram?",answer:"Wednesday at 19:00 is the strongest single slot on these estimates, and the evening window from 18:00 to 20:00 is strong on every day. Tuesday and Thursday at 19:00 are within a point of Wednesday, so anything midweek in that window is a good slot."},{question:"What is the best day to post on Instagram?",answer:"Wednesday, followed closely by Tuesday and Thursday. Monday and Friday evenings are noticeably softer at the same hour, and Saturday is the weakest day of the week overall, though it never drops far."},{question:"Is it better to post on Instagram in the morning or the evening?",answer:"Evening. There is a genuine lunch rise around 11:00 to 13:00, but it stays below the 18:00 to 20:00 block on every day of the week. Mornings before 09:00 are the weakest usable hours on the grid."},{question:"When should I post Reels on Instagram?",answer:"The same evening window works. Reels reach beyond your followers, so the hour matters a little less than it does for a feed post, but the first hour of engagement still shapes how far the Reel travels, and there are simply more people watching at 19:00 than at 09:00."},{question:"Does posting time still matter on Instagram in 2026?",answer:"It matters less than it did before recommendations took over the feed, and more than people who post at random assume. The hour no longer decides who sees a post, but it decides how many people are around to react in the first hour, and that is still an input to how far it goes."}],relatedToolSlugs:["instagram-engagement-rate-calculator","instagram-character-counter","best-time-to-post","best-time-to-post-on-threads"]},"best-time-to-post-on-facebook":{slug:"best-time-to-post-on-facebook",family:"best-time",platform:"facebook",datePublished:y,lastUpdated:y,label:"Best time to post on Facebook",metaTitle:"Best Time to Post on Facebook (2026 Guide)",metaDescription:"Facebook peaks Wednesday at 13:00, inside a weekday window from 10:00 to 14:00, and evenings are weak. See the hour by hour heatmap and get a weekly plan.",heroEyebrow:"Free Facebook tool",heroTitle:"Best Time to Post on Facebook",heroLead:"Facebook is a daytime network: Wednesday at 13:00 is the strongest slot, the weekday window runs 10:00 to 14:00, and by 19:00 a weekday has already fallen back to about two thirds of its midday level.",intro:["Facebook is the one network here where the evening is a mistake. It wakes up early, is already strong by 09:00, peaks at 13:00 on every weekday, and then slides steadily until midnight. Posting at 20:00 because that is when you finished work is the most common avoidable timing error on this platform.","The usable block is wide, which makes it forgiving. From 10:00 to 14:00 a midweek day stays close to its peak, with a mid-morning high around 10:00 and a shoulder at 14:00, so anything inside the working day lands somewhere reasonable. Wednesday leads, Tuesday and Thursday are close behind, and Friday drops off.","Weekends are quieter across the board and Saturday is the weakest day of the seven. Sunday holds a mild rise from midday into the early evening rather than a real peak. Save the weekend for evergreen posts and put anything time sensitive midweek, around lunchtime."],tips:["Aim for 13:00 midweek and treat 10:00 to 14:00 as the acceptable range. Outside that band you are giving up audience for no reason.","Stop scheduling Facebook posts for the evening out of habit. The 19:00 slot that works on Instagram is roughly a third weaker here than the same day at 13:00.","Comments matter more than likes on Facebook, because organic reach is tight and a live comment thread keeps a post surfacing for hours. Post when you can actually reply.","Use Saturday for things that do not expire. It is the weakest day of the week, so an evergreen post loses less there than an announcement would.","If your Page serves several time zones, lean towards where most of your audience is rather than posting twice and competing with yourself."],faqs:[{question:"What is the best time to post on Facebook?",answer:"Wednesday at 13:00 on these estimates, with 10:00 to 14:00 strong on every weekday. Tuesday and Thursday at 13:00 are close behind Wednesday, so the middle of a midweek day is the reliable answer."},{question:"What is the best day to post on Facebook?",answer:"Wednesday, then Tuesday and Thursday. Friday falls off noticeably and Saturday is the weakest day of the week, scoring well under any weekday at the same hour."},{question:"Is it better to post on Facebook in the morning or the evening?",answer:"Morning, or better still early afternoon. Facebook is already strong by 09:00 and peaks at 13:00, while the evening is the weakest part of its waking day: by 19:00 a weekday is back to roughly two thirds of the 13:00 level and still falling."},{question:"Why is Facebook different from Instagram if Meta owns both?",answer:"Different audiences and different habits. Facebook skews older and is used through the day, often on desktop and in short checks, while Instagram is a phone-in-the-evening app. Same company, opposite peaks: 13:00 against 19:00."},{question:"Does posting time still matter on Facebook in 2026?",answer:"Yes, arguably more than elsewhere. Organic reach on Pages is tight enough that early engagement is what keeps a post alive at all, so posting when your audience is awake and reachable does real work here."}],relatedToolSlugs:["facebook-engagement-rate-calculator","facebook-character-counter","best-time-to-post","best-time-to-post-on-instagram"]},"best-time-to-post-on-threads":{slug:"best-time-to-post-on-threads",family:"best-time",platform:"threads",datePublished:y,lastUpdated:y,label:"Best time to post on Threads",metaTitle:"Best Time to Post on Threads (2026 Guide)",metaDescription:"Threads peaks at 20:00 every day of the week, inside a 19:00 to 21:00 evening window. See the full hour by hour heatmap and build a weekly posting plan.",heroEyebrow:"Free Threads tool",heroTitle:"Best Time to Post on Threads",heroLead:"Threads runs about an hour later than Instagram: 20:00 is the peak on all seven days of the week, inside an evening window from 19:00 to 21:00.",intro:["Threads borrowed the Instagram rhythm and pushed it back an hour. The evening conversation block is the whole story: it builds from 18:00, peaks at 20:00 on every single day of the week, and is still strong at 21:00 when Instagram has already started to fade.","The late-night floor is the highest of any text network in this dataset. At 23:00 Threads is still scoring about double what X or Facebook manage at the same hour, and midnight holds low double digits where LinkedIn is barely above zero. It is not a peak, but it is not dead air either.","Weekdays beat weekends, with Tuesday and Wednesday at 20:00 the strongest cells, but the gap is small. Sunday evening comes back to within a few points of a Monday, so a seven day rhythm costs you very little here, and a conversational format rewards showing up often."],tips:["Put your main post at 20:00 and use the hour either side for replies. Threads is a conversation network, so the follow-ups do as much work as the original.","Do not simply mirror your Instagram schedule. The peak here is an hour later, and a post cross-posted at 19:00 arrives before the Threads audience does.","Late is workable. Threads holds more activity after 22:00 than any other text network here, so a good reply at 23:00 is not wasted the way it would be on LinkedIn.","Post more often than you would on Instagram. The feed moves quickly and short posts are cheap to make, so frequency inside the evening window matters more than precision.","Ask something answerable. The evening block is when people have time to type, which is exactly what a question needs."],faqs:[{question:"What is the best time to post on Threads?",answer:"20:00 is the peak on every day of the week on these estimates, with 19:00 to 21:00 strong throughout. Tuesday and Wednesday at 20:00 are the two strongest cells in the grid."},{question:"What is the best day to post on Threads?",answer:"Wednesday, with Tuesday level or a point behind. The spread across the week is narrow though: Sunday evening comes back to within a few points of a Monday, so no day is a write-off."},{question:"Is Threads the same as Instagram for timing?",answer:"Close, but shifted later. Instagram peaks at 19:00 and fades after 21:00, Threads peaks at 20:00 and holds. If you cross-post, moving the Threads version an hour later is the single easiest improvement you can make."},{question:"Is it worth posting on Threads late at night?",answer:"More than on other networks. Threads keeps a higher overnight floor than Facebook, X or LinkedIn, so a late reply still reaches people. It is not the place for your best post of the day, but it is not throwaway either."},{question:"Does posting time still matter on Threads in 2026?",answer:"Yes, because Threads is conversational. Being there while people are replying is most of the value, and the replies happen in the evening block. A post that lands when nobody is around to answer it starts and stops in the same minute."}],relatedToolSlugs:["threads-character-counter","best-time-to-post","best-time-to-post-on-instagram","threads-video-size-checker"]},"best-time-to-post-on-linkedin":{slug:"best-time-to-post-on-linkedin",family:"best-time",platform:"linkedin",datePublished:y,lastUpdated:y,label:"Best time to post on LinkedIn",metaTitle:"Best Time to Post on LinkedIn (2026 Guide)",metaDescription:"LinkedIn peaks Tuesday and Wednesday at 10:00, inside a weekday morning window from 09:00 to 11:00, and weekends collapse. See the heatmap and weekly plan.",heroEyebrow:"Free LinkedIn tool",heroTitle:"Best Time to Post on LinkedIn",heroLead:"LinkedIn is a working hours network: weekday mornings between 09:00 and 11:00 carry it, 10:00 is the peak on all five weekdays, and Tuesday and Wednesday at 10:00 are level at the very top.",intro:["No network in this dataset has a sharper shape than LinkedIn. It is close to nothing overnight, climbs steeply from 07:00, and reaches its high point at 10:00 on every weekday. Tuesday and Wednesday at 10:00 are tied as the strongest cells on the grid, with Thursday just behind and Monday and Friday clearly softer.","The fall after lunch is steady rather than sudden. By 15:00 a weekday is at roughly two thirds of its 10:00 level, by 17:00 about a third, and after 18:00 it collapses. An evening LinkedIn post is competing for attention that has left the building, which is why the same post moved from 19:00 to 10:00 can look like a different post entirely.","The weekend is the most extreme drop anywhere in this dataset: a whole Saturday adds up to less than a third of a Wednesday, and its best hour barely matches what a weekday manages before 08:00. Treat Saturday and Sunday as off, and spend the saved effort on getting Tuesday to Thursday mornings right."],tips:["Post between 09:00 and 11:00, Tuesday to Thursday, and stop trying to be clever about it. That block is where the whole network is.","Block the first two hours after posting for replies. LinkedIn keeps a post alive for days rather than hours, and early comments are what start that run.","Do not post on Saturday and Sunday. The best weekend hour on LinkedIn is weaker than an average weekday hour, so a good post published then is simply wasted.","Avoid the 17:00 slot even though it feels like a natural end of day. By then the grid has already fallen to about a third of the morning peak and it keeps dropping.","If your audience spans continents, pick the morning of the region that matters most rather than compromising on a middle hour that misses both."],faqs:[{question:"What is the best time to post on LinkedIn?",answer:"Between 09:00 and 11:00 on a weekday, with 10:00 the peak on all five. Tuesday and Wednesday at 10:00 are level at the top of these estimates, and Thursday is a point or two behind."},{question:"What is the best day to post on LinkedIn?",answer:"Tuesday and Wednesday, which score identically, followed by Thursday. Monday is softer, Friday softer again, and both weekend days fall away completely."},{question:"Is it better to post on LinkedIn in the morning or the evening?",answer:"Morning, and it is not close. The 10:00 peak is several times the 19:00 level on the same day. LinkedIn is used during working hours, so an evening post arrives after the audience has closed the tab."},{question:"Should I post on LinkedIn at the weekend?",answer:"No. Saturday totals less than a third of a Wednesday on these estimates and Sunday is only slightly better. If you want a weekend habit, write at the weekend and schedule for Tuesday morning."},{question:"Does posting time still matter on LinkedIn in 2026?",answer:"Yes, more than on the recommendation-driven networks. LinkedIn distribution still leans heavily on the first wave of engagement from your own network, and that wave only exists during working hours."}],relatedToolSlugs:["linkedin-engagement-rate-calculator","linkedin-character-counter","best-time-to-post","best-time-to-post-on-twitter"]},"best-time-to-post-on-twitter":{slug:"best-time-to-post-on-twitter",family:"best-time",platform:"twitter",datePublished:y,lastUpdated:y,label:"Best time to post on X",metaTitle:"Best Time to Post on X / Twitter (2026 Guide)",metaDescription:"X peaks Tuesday and Wednesday at 12:00, inside a 09:00 to 13:00 weekday window, with a second wind around 17:00. See the heatmap and build a weekly plan.",heroEyebrow:"Free X tool",heroTitle:"Best Time to Post on X (Twitter)",heroLead:"X is a commute and lunch network: the weekday window runs 09:00 to 13:00 and peaks at 12:00, with Tuesday and Wednesday level at the top and a second rise in the late afternoon.",intro:["X wakes up on the commute. Between 06:00 and 09:00 a weekday triples, arriving within a few points of its daily high before most people have sat down, then holds that level all the way through to 13:00 and peaks at 12:00. Tuesday and Wednesday at 12:00 are tied as the strongest slots of the week.","Unlike Facebook there is a genuine second wind. Late afternoon, around 16:00 to 17:00, lifts back close to the morning level as the news cycle picks up again, before easing off through the evening. Those two windows, midday and late afternoon, are where a post has the best chance of catching a scroll.","Weekends drop by roughly a third and change shape entirely. Saturday flattens into a long, mild plateau with no real peak, and Sunday moves its best hour to the early evening around 18:00, the only day on X where the evening beats the middle of the day. Volume matters more than precision here: the timeline moves fast enough that a good post at an average hour still works."],tips:["Anchor the day at 12:00 and use 09:00 or 17:00 for the second and third posts. Those three cover the morning ramp, the peak and the late afternoon rise.","Post more often than you would anywhere else. The timeline moves fast, the half life of a post is short, and frequency compensates for an imperfect hour in a way it does not on LinkedIn.","Replies are what X rewards with distribution, so post when you can stay and answer. A post that ends in a question at 12:00 outperforms the same post left alone at 22:00.","On Sunday, move your slot to about 18:00. It is the only day of the week where the evening is the strongest part of the day on this network.","Do not bother with the overnight hours. The floor between 01:00 and 05:00 is among the lowest in this dataset and there is no compensating quiet-hours advantage."],faqs:[{question:"What is the best time to post on X (Twitter)?",answer:"12:00 on a weekday, with 09:00 to 13:00 strong throughout. Tuesday and Wednesday at 12:00 are level at the top of these estimates, and there is a secondary window around 16:00 to 17:00 on every weekday."},{question:"What is the best day to post on X?",answer:"Tuesday and Wednesday, which score identically at the peak hour, then Thursday. Saturday is the weakest day of the week and flattens out, while Sunday recovers in the evening rather than at midday."},{question:"Is it better to post on X in the morning or the evening?",answer:"Morning through midday on weekdays. The 07:00 to 09:00 ramp and the 12:00 peak carry the week, and the evening is in decline everywhere except Sunday, when the best hour of the day is around 18:00."},{question:"How often should I post on X?",answer:"More than once a day if you can. Because posts have such a short life in the timeline, several posts spread across the 09:00 to 17:00 range will out-reach one perfectly timed post, which is the opposite of the advice for LinkedIn."},{question:"Does posting time still matter on X in 2026?",answer:"It matters less than on any other network here. The recommended timeline surfaces older posts and the feed churns quickly, so a strong post finds people whenever it lands. Timing on X is a small edge rather than a deciding factor."}],relatedToolSlugs:["twitter-engagement-rate-calculator","twitter-character-counter","best-time-to-post","best-time-to-post-on-linkedin"]},"best-time-to-post-on-tiktok":{slug:"best-time-to-post-on-tiktok",family:"best-time",platform:"tiktok",datePublished:y,lastUpdated:y,label:"Best time to post on TikTok",metaTitle:"Best Time to Post on TikTok (2026 Guide)",metaDescription:"TikTok peaks at 20:00 every day of the week, inside a 19:00 to 21:00 window, and weekends score as high as weekdays. See the heatmap and weekly plan.",heroEyebrow:"Free TikTok tool",heroTitle:"Best Time to Post on TikTok",heroLead:"TikTok skews later than anything else: 20:00 is the peak on all seven days, the window runs 19:00 to 21:00, and Wednesday at 20:00 is the strongest slot in this entire dataset.",intro:["TikTok is the latest-peaking network here and the most consistent about it. The block from 19:00 to 21:00 dominates every day of the week, 20:00 is the high point on all seven, and Wednesday at 20:00 scores higher than any cell on any other network in this dataset.","The late-night tail is real. At 23:00 TikTok is still around half its peak, and even 01:00 holds a level that would be a dead hour on LinkedIn or Facebook. Posting after midnight is not the plan, but it is a long way from wasted, which is not true anywhere else here.","Weekends do not dip at all. Saturday and Sunday both add up to more than a Monday across the day, because the For You feed never depended on people being at a desk. That makes TikTok the one network where a seven day schedule is genuinely worth the effort and where the weekend slots are as good as the weekday ones."],tips:["Aim for 20:00 and treat 19:00 to 21:00 as the window. That block is the strongest part of the day on every single day of the week.","Post at the weekend too. Saturday and Sunday both add up to more than a Monday here, which is unique in this dataset, so a seven day rhythm actually pays.","Watch time still decides how far a video travels. Timing gets you a bigger starting audience, but the first two seconds decide what happens after that.","A late upload is not a lost upload. TikTok keeps enough activity past 23:00 that a video posted late can still start properly, unlike on the daytime networks.","If a video is still gaining views the next morning, do not bury it by posting again immediately. Give it the evening slot to itself."],faqs:[{question:"What is the best time to post on TikTok?",answer:"20:00, on any day of the week. It is the peak hour on all seven days of these estimates, with 19:00 and 21:00 close behind, and Wednesday at 20:00 is the strongest single slot in the whole dataset."},{question:"What is the best day to post on TikTok?",answer:"Wednesday is marginally the strongest, then Tuesday and Thursday, but the week is unusually flat: Saturday and Sunday both total more than a Monday, so no day is a bad day here."},{question:"Is it better to post on TikTok in the morning or the evening?",answer:"Evening, clearly. The morning is the weakest usable part of the TikTok day, and even midday sits well below the 19:00 to 21:00 block. If you can only post once, post in the evening."},{question:"Should I post on TikTok at the weekend?",answer:"Yes. TikTok is the only network in this dataset where the weekend is essentially as strong as the working week, because the For You feed does not care whether anyone is at work."},{question:"Does posting time still matter on TikTok in 2026?",answer:"Least of all here, but it is not nothing. The For You feed can pick a video up hours or days after it was posted, so the hour is not decisive. What it does is set how many people see the video in its first push, which is the signal the feed uses to decide whether to keep pushing."}],relatedToolSlugs:["tiktok-engagement-rate-calculator","tiktok-character-counter","best-time-to-post","best-time-to-post-on-youtube"]},"best-time-to-post-on-youtube":{slug:"best-time-to-post-on-youtube",family:"best-time",platform:"youtube",datePublished:y,lastUpdated:y,label:"Best time to post on YouTube",metaTitle:"Best Time to Post on YouTube (2026 Guide)",metaDescription:"YouTube viewing peaks at 20:00, inside an 18:00 to 21:00 window, and Sunday is the strongest day of the week. See the heatmap and build a weekly plan.",heroEyebrow:"Free YouTube tool",heroTitle:"Best Time to Post on YouTube",heroLead:"YouTube is after-work viewing: the evening window runs 18:00 to 21:00 and peaks at 20:00, Sunday is the strongest day of the week, and publishing a couple of hours early is how you meet it.",intro:["YouTube timing is the one case where publishing time and viewing time are not the same question. The grid below is when people watch: it climbs from about 16:00, is strong by 18:00, and peaks at 20:00 on every weekday, with 19:00 and 21:00 close enough that the whole block is good.","That is why the usual advice is to publish two to three hours ahead of the peak. Giving a video an afternoon to collect its first views, its first comments and its early retention data means it arrives in the evening with momentum behind it rather than starting cold at exactly the moment everyone is looking.","The weekend is the shape change worth planning around. Saturday and Sunday afternoons stay high for hours instead of dipping, and Sunday is the strongest day of the week overall. Longer videos, and anything people sit down for rather than glance at, belong there."],tips:["Publish in the mid to late afternoon so the video is warm by the 20:00 peak. Publishing at 20:00 itself means competing for that peak from a standing start.","Put your longest videos on Saturday or Sunday. The weekend afternoon window is hours wide instead of the sharp weekday evening spike, and Sunday scores highest of any day.","Do not move a slot your subscribers already know. YouTube notifications and habit do a lot of the work, and consistency beats a marginally better hour.","Use Shorts to fill the gaps rather than moving your main upload. A Short in the evening costs nothing and does not compete with the long video for the same slot.","Watch the first 24 hours, not the first hour. YouTube distribution builds over days, so judge a slot on a week of data rather than an afternoon of it."],faqs:[{question:"What is the best time to post on YouTube?",answer:"Viewing peaks at 20:00, with 18:00 to 21:00 strong every day. Because a video needs a head start, publishing in the mid to late afternoon is the usual way to reach that peak with momentum already built."},{question:"What is the best day to post on YouTube?",answer:"Sunday scores highest across the whole day on these estimates, thanks to a long afternoon window that no weekday has. Among weekdays, Wednesday leads, with Tuesday and Thursday close behind."},{question:"Is it better to post on YouTube in the morning or the evening?",answer:"People watch in the evening, so aim at 18:00 to 21:00. That does not mean publishing then: the standard approach is to upload a few hours earlier so the video has collected its first signals by the time the audience arrives."},{question:"Should I upload at the weekend?",answer:"Yes, especially for longer videos. Saturday and Sunday hold a high level from late morning through the afternoon rather than spiking once in the evening, and Sunday is the strongest day of the week overall."},{question:"Does upload time still matter on YouTube in 2026?",answer:"Less than on feed-based networks, because YouTube keeps recommending a video for weeks. It still matters for the first day: a video that lands into an active evening gathers its early watch-time data faster, and that data is what the recommendation system acts on."}],relatedToolSlugs:["youtube-engagement-rate-calculator","youtube-character-counter","best-time-to-post","best-time-to-post-on-tiktok"]},"best-time-to-post-on-pinterest":{slug:"best-time-to-post-on-pinterest",family:"best-time",platform:"pinterest",datePublished:y,lastUpdated:y,label:"Best time to post on Pinterest",metaTitle:"Best Time to Post on Pinterest (2026 Guide)",metaDescription:"Pinterest peaks at 21:00 on weekdays and scores higher across the weekend than any weekday. See the hour by hour heatmap and build a weekly pinning plan.",heroEyebrow:"Free Pinterest tool",heroTitle:"Best Time to Post on Pinterest",heroLead:"Pinterest peaks later than almost anything else: 21:00 is the high point on every weekday, and both Saturday and Sunday score higher across the day than any weekday does.",intro:["Pinterest is planning behaviour, and planning happens late. The evening block runs from 20:00 to 21:00 on weekdays, 21:00 is the high point every weekday, and even 22:00 is still ahead of anything the same day managed before 18:00. Wednesday at 21:00 is the strongest single slot of the week.","The rest of the weekday is remarkably flat. From 10:00 to 17:00 a Tuesday hovers in a narrow band with no real peak, so the middle of the working day is not a bad time so much as an unremarkable one. If you are pinning once a day, the evening is where that pin should go.","Weekends are the exception and the reason Pinterest is worth scheduling around at all. Saturday and Sunday both score higher in total than any weekday, and both add a long late-morning to afternoon window, roughly 11:00 to 14:00, that simply does not exist Monday to Friday. Planning content, the kind people save for later, belongs there."],tips:["Pin in the evening, around 21:00, on weekdays. It is the peak every weekday and the window either side stays strong.","Treat the weekend as prime time, not overflow. Both weekend days out-score every weekday here, which is true of no other network in this dataset except YouTube.","Use the weekend late-morning window, about 11:00 to 14:00, for anything seasonal or project-shaped. That window only exists on Saturday and Sunday.","Space pins out rather than dumping a board at once. Pinterest surfaces content for months, so a steady drip across the week beats a single batch.","Do not judge a pin in a day. Pinterest is the slowest network here to show results, and a pin published tonight can still be finding people next season."],faqs:[{question:"What is the best time to post on Pinterest?",answer:"21:00 is the peak on every weekday on these estimates, with 20:00 to 22:00 strong throughout. Wednesday at 21:00 is the single strongest slot of the week."},{question:"What is the best day to post on Pinterest?",answer:"Sunday, then Saturday. Both weekend days score higher across the day than any weekday, and among weekdays Wednesday leads. Friday is the weakest day of the seven."},{question:"Is it better to post on Pinterest in the morning or the evening?",answer:"Evening on weekdays, where the peak is at 21:00. Weekends are different: they keep the evening peak but add a long late-morning to afternoon window around 11:00 to 14:00 that weekdays do not have."},{question:"Should I pin at the weekend?",answer:"Yes. Pinterest and YouTube are the two networks in this dataset where the weekend beats the working week, and on Pinterest the gap is clear rather than marginal."},{question:"Does pinning time still matter in 2026?",answer:"Less than on any feed-based network, because Pinterest is a search and save platform where a pin can keep earning for months. Timing decides how much of a head start a pin gets in its first days, not its ceiling."}],relatedToolSlugs:["pinterest-character-counter","best-time-to-post","pinterest-video-size-checker","best-time-to-post-on-instagram"]},"content-calendar-generator":{slug:"content-calendar-generator",family:"content-calendar",platform:null,datePublished:x,lastUpdated:x,label:"Content calendar generator",metaTitle:"Free 30 Day Content Calendar Generator (Social Media)",metaDescription:"Free social media content calendar generator. Pick an industry and a cadence and get 30 days of post ideas built from 5 content pillars. No account needed.",heroEyebrow:"Free tool",heroTitle:"Free 30 Day Content Calendar Generator",heroLead:"Pick your industry and how often you want to post, and get a 30 day social media content calendar with a pillar, a format and a written prompt on every posting day. Five posts a week fills 22 of the 30 days.",intro:["The hard part of posting consistently is almost never the posting. It is opening an empty composer on a Tuesday morning with no idea what today is supposed to be, deciding that you will think of something later, and then not thinking of something later. A month of that is how a feed goes quiet, and it happens to accounts with plenty to say.","A calendar fixes it by making the decision once instead of thirty times. This generator rotates five content pillars, Educate, Engage, Showcase, Social proof and Promote, across a pool of topics for your industry. Each pillar owns one format, so a carousel day never lands next to another carousel day, and the promote slot arrives once every five posts instead of whenever you happen to feel like selling something.","Pick an industry, pick three, five or seven posts a week, and the whole month comes out at once: a weekday, a pillar, a format and a written prompt for every posting day, with the rest days left visibly empty so a lighter cadence looks like a plan rather than a gap. The generator is deterministic, so the same two choices always produce the same calendar, and the 30 day version we email you is built by the same generator you just ran in your browser."],tips:["Batch by format, not by day. Every carousel in the month is one Educate sitting, every clip is one Showcase sitting. Filming five short videos back to back takes about as long as filming two on separate afternoons, because the setup is what costs you, not the shooting.","Repurpose one prompt across networks instead of writing four. A Showcase clip is a Reel, a Short and a TikTok with three different captions, and the Educate carousel becomes a LinkedIn document and a thread on X. Write the idea once, then rewrite only the first line for each network.","Break the plan on purpose when something real happens. A launch, an outage, a customer story that lands in your inbox on a Wednesday: post it, and push the scheduled prompt to the next open slot. A calendar exists to make the quiet weeks easy, not to outrank news.","Tag every post with its pillar and read your results by pillar after a month. Most accounts find that one pillar carries the reach and another carries the replies. When you know which is which, you stop treating a low-comment Educate carousel as a failure and start using each pillar for the job it actually does.","Rewrite the topic in your own language before you publish. The topic pool is a starting structure, and the version that works is the one where you swap in the exact question a customer asked you last week. Keep the pillar and the format, change the words.","Leave the Promote slot at one in five. It is tempting to convert an Engage day into a second offer post during a launch week, and the accounts that do it every week are the ones whose reach quietly collapses. If you need more promotion, add a story or a link in the caption of a post that earns its place on its own."],faqs:[{question:"How is the content calendar generated?",answer:"By rotation, not by AI. Five content pillars each own one post format and one set of six hand-written prompt templates. Walking through the month, every posting day takes the next pillar in the cycle and the next topic from your industry pool, and the prompt is that pillar template with your topic substituted into it. Nothing is generated by a language model and nothing is random, so the same industry and cadence always produce the same 30 days."},{question:"Can I change the posting days?",answer:"Not inside the tool, but the grid is simple enough to shift by hand. Three a week is Monday, Wednesday and Friday. Five a week is Monday to Friday. Seven a week is every day. Day 1 is always a Monday, so if you start the plan on a Wednesday, day 1 becomes your Wednesday and everything moves with it. The order of the pillars is what matters, not the weekday names."},{question:"Do I need to give my email to use it?",answer:"No, not to use it. The first week of your calendar generates on the page with no address at all, and a full sample week with real prompts is printed further down whether you generate anything or not. Days 8 to 30 unlock when you ask us to email them, and the emailed calendar is built by the same generator, from the same pillars and the same topics, so there is nothing behind the form that is not already on the page."},{question:"Which industries are covered?",answer:"Thirteen: general or mixed, beauty, fashion, fitness, food and beverage, travel, tech and SaaS, ecommerce, education, finance, health and wellness, media and entertainment, and real estate. Each one has eight topics written for it, and general or mixed is the fallback if none of the other twelve fits. If your niche sits between two of them, generate both and take the prompts you like from each."},{question:"Does it work for more than one social network?",answer:"Yes. The plan is network agnostic, and picking a network only renames the formats so they match what that app calls them, a short video becoming a Reel on Instagram or a Short on YouTube. The pillars, the rotation, the topics and the prompts are identical either way, which is what makes one calendar usable across every account you run."},{question:"Is anything stored?",answer:"Only if you ask for the emailed calendar. The generator runs entirely in your browser, and your industry and cadence are not sent anywhere while you click around. If you request the report we receive your email address, the industry and cadence you picked and which page you were on, so we can send it and know which tool produced it. Marketing email is a separate checkbox that starts unticked."}],relatedToolSlugs:["best-time-to-post","social-media-character-counter","engagement-rate-calculator","sponsored-post-rate-calculator","social-media-post-preview"]},"thread-splitter":{slug:"thread-splitter",family:"thread-splitter",platform:null,datePublished:K,lastUpdated:K,label:"Thread splitter",metaTitle:"Thread Splitter for X and Threads",metaDescription:"Free thread splitter: paste long text and get numbered posts that fit 280 on X or 500 on Threads. Breaks on sentences, counts links at 23, no upload.",heroEyebrow:"Free tool",heroTitle:"Thread Splitter for X and Threads",heroLead:"Paste something too long for one post and get it back as a numbered thread that breaks on sentence boundaries, sized for the 280 characters X allows or the 500 on Threads.",intro:["Splitting a long draft by hand is the kind of task that looks like it takes two minutes and takes twenty. You count to 280, you land mid-clause, you move the break, and now every number in the thread is wrong because you added a post in the middle.","This splitter does the arithmetic instead. It reads your text as paragraphs and sentences rather than as a character stream, packs as many whole sentences into each post as will fit, and only ever cuts inside a sentence when a single sentence is genuinely longer than the limit. Numbering is applied last and charged against the same budget as the words, which is the part most manual splits get wrong.","Everything runs in your browser. There is no account, no upload, and no copy of your draft on our side: the text you paste stays in the page you are reading."],tips:["Write the first post last. It is the only one most people see in the feed, so it has to work as a standalone statement rather than as the opening half of a sentence.","Leave a blank line between paragraphs before you paste. The splitter treats a paragraph break as a strong hint and will start a new post there whenever the next sentence does not fit.","Keep threads short enough to finish. Five to ten posts is where most threads hold attention; past fifteen the completion rate falls off sharply and the last posts are read by almost nobody.",'Numbering is not free. On X a "12/14 " prefix costs six of your 280 characters on every single post, so switch to "1/ " or turn numbering off if the thread is running tight.',"Put the link in the last post, not the first. A URL costs 23 characters on X wherever it sits, and a link in post one gives people somewhere to go before they have read anything.","Read the split before you publish. The tool breaks on sentences, but only you know which sentence is the punchline that deserves a post of its own."],faqs:[{question:"Does the numbering count against the character limit?",answer:'Yes. A prefix like "3/12 " is ordinary text as far as X and Threads are concerned, so it spends characters like anything else. This splitter reserves room for the widest prefix in the thread before it packs, then repacks if adding the numbers changed how many posts you need.'},{question:"How are links counted on X?",answer:"Every URL is rewritten through t.co and charged at a flat 23 characters, however long the original link is. The splitter applies that weighting when you pick X, so a post with a 180 character tracking URL is measured the way X will measure it, not the way your text editor does."},{question:"Is my text uploaded or stored anywhere?",answer:"No. The splitting happens in your browser with JavaScript, nothing is sent to a server, and nothing is saved. Close the tab and the draft is gone."},{question:"How many posts should a thread be?",answer:"Five to ten for most topics. That is long enough to develop an idea and short enough that people reach the end. If your draft splits into twenty-five posts, the honest fix is usually to publish it as an article and use a short thread to sell the click."},{question:"Where does the splitter break the text?",answer:"At sentence boundaries first, and at paragraph boundaries in preference to sentence ones. A sentence is only cut open when it is longer than a whole post on its own, and then it breaks on a space rather than mid-word. Emoji and flags are never split down the middle."},{question:"Can I use the same draft for X and Threads?",answer:"You can, but switch the network toggle and check both. Threads gives you 500 characters per post against 280 on X, so the same text usually becomes roughly half as many posts, and the breaks land in different places."}],relatedToolSlugs:["twitter-thread-maker","threads-post-splitter","twitter-character-counter","threads-character-counter"]},"twitter-thread-maker":{slug:"twitter-thread-maker",family:"thread-splitter",platform:"twitter",datePublished:K,lastUpdated:K,label:"Twitter thread maker",metaTitle:"Twitter Thread Maker and Text Splitter",metaDescription:"Turn a long draft into a numbered X thread. Each post is checked against the 280 limit with links weighted at 23, and nothing leaves your browser.",heroEyebrow:"Free X tool",heroTitle:"X (Twitter) Thread Maker",heroLead:"Paste a draft of any length and get a numbered X thread back, with every post measured against 280 characters and every link charged the flat 23 that X charges.",intro:["A thread is how anything longer than a paragraph gets published on X. The limit is 280 characters per post for a standard account, and the way you get past it is to reply to yourself, not to write more.",'The two things that make hand-splitting painful are both handled here. Links do not cost what they look like: X rewrites every URL through t.co and bills you 23 characters no matter what, so a post that looks 340 characters long in a text editor may fit comfortably. And numbering is text, so a "1/12 " prefix quietly takes six characters off every post in the thread.',"This thread maker packs whole sentences into each post, reserves the right amount of room for the numbering style you pick, and flags any post that still comes out over the line. Nothing is uploaded and nothing is stored."],tips:["The first post is the whole pitch. It is the only one the timeline shows to people who do not already follow you, so it has to earn the tap on its own.","One link costs 23 characters, two cost 46. Put the single link you care about in the last post and leave the rest of the thread clean.","Attach media instead of describing it. Images, videos and GIFs cost nothing against the 280, so a screenshot is often the cheapest way to add the detail that will not fit.","Reply to your own post to continue the thread. Do not publish the parts separately and hope people find them, an orphaned post 4 reads as a fragment.",'X Premium raises the ceiling to 25,000 characters, but the timeline still only shows the first 280 before a "Show more" toggle, so a thread usually still outperforms one long post.',"If the split lands a punchline in the middle of a post, move the break by hand. Sentence boundaries are a good default, not an editorial judgment."],faqs:[{question:"Does the numbering count against the 280 character limit?",answer:'Yes. "1/12 " is five characters of your 280 and every post in the thread pays it. This tool reserves room for the widest prefix before it packs, so no post goes over once the numbers are added.'},{question:"How does X count links in a thread?",answer:"Every URL is wrapped in a t.co link and charged at a flat 23 characters regardless of its real length. Shortening a URL before you paste it saves you nothing on X. This splitter applies the same 23 character weight, so the counts you see match the composer."},{question:"Is anything I paste uploaded or saved?",answer:"No. The whole thread is built in your browser, nothing is sent anywhere, and nothing is stored. There is no account step and no email gate."},{question:"How many posts should a Twitter thread have?",answer:"Five to ten is the range that holds together. Threads shorter than three rarely need to be threads at all, and past fifteen posts the drop-off between the first and the last is severe enough that the ending is barely read."},{question:"Do I still need this if I have X Premium?",answer:'Often yes. Premium lets a single post run to 25,000 characters, but everything past the first 280 is collapsed behind a "Show more" control in the timeline. A thread keeps each idea visible in the feed instead of hiding it behind a click.'},{question:"How do I publish the thread once it is split?",answer:"Copy the first post, publish it, then reply to your own post with the second and keep going. If you would rather not sit through that, Postify composes and schedules the whole chain in one step and publishes the replies for you."}],relatedToolSlugs:["thread-splitter","threads-post-splitter","twitter-character-counter","social-media-character-counter"]},"threads-post-splitter":{slug:"threads-post-splitter",family:"thread-splitter",platform:"threads",datePublished:K,lastUpdated:K,label:"Threads post splitter",metaTitle:"Threads Post Splitter for the 500 Limit",metaDescription:"Split long text into a Threads chain where every post fits the 500 character limit. Breaks on sentences, numbers each post, runs in your browser.",heroEyebrow:"Free Threads tool",heroTitle:"Threads Post Splitter",heroLead:"Threads caps every post at 500 characters, so anything longer becomes a chain. Paste your text and get the chain back, broken on sentences rather than at exactly 500.",intro:["Threads holds 500 characters per post and does not negotiate. That is three or four sentences, room for one clear idea, and the reason longer thoughts on Threads are published as a chain of replies rather than as a single block.","A chain only reads well if the breaks land somewhere deliberate. Cut at exactly 500 characters and the first post ends mid-clause, which reads like a truncation bug rather than like pacing. This splitter works in sentences and paragraphs instead, so each post ends where a thought ends.","Links are worth watching here. Threads counts a URL as every character it contains, unlike X which charges a flat 23, so a long tracking link can spend a fifth of a post before you write anything. Shorten it first. Nothing you paste is uploaded or stored."],tips:["Make the first post work alone. The feed shows the opener and folds the rest of the chain behind it, so a post that only makes sense after post two will not get a reader to post two.","Shorten links before you paste them. Threads charges the full length of a URL, so a 90 character tracking link is nearly a fifth of a post.","One topic tag per post, and it spends characters like any other text. There is no Instagram style tag block on Threads to fall back on.","Space the chain with paragraph breaks in your draft. The splitter starts a new post at a paragraph boundary whenever the next sentence will not fit, which usually matches where you would have broken it yourself.","Do not paste a 2,200 character Instagram caption and hope. Write for 500 and expand for Instagram, rather than letting something truncate the same text in two different places.","Publish the chain as replies to your own post so Threads groups it. Posting the parts separately scatters them through the feed."],faqs:[{question:"Does the numbering count against the 500 character limit?",answer:'Yes. Threads treats "2/6 " as ordinary text, so it comes out of the same 500 characters. The splitter reserves room for the widest prefix in the chain before packing, then repacks if the numbering changed how many posts you need.'},{question:"How many characters can a Threads post have?",answer:"Five hundred, including spaces, emoji, links and the topic tag. The limit applies to every post in a chain individually rather than to the chain as a whole, so a six post chain gives you 3,000 characters in total."},{question:"How do links count on Threads compared to X?",answer:"Threads counts a URL as every character it actually contains. X is the exception: it rewrites links through t.co and charges a flat 23 characters however long they are. Switch this tool to X and it applies that 23 character weighting instead."},{question:"Is my text uploaded or stored anywhere?",answer:"No. The chain is built in your browser, nothing is sent to a server, and nothing is saved. No account, no email step."},{question:"How long should a Threads chain be?",answer:"Five to ten posts covers most subjects. Threads readers move faster than blog readers, and a chain that runs past fifteen posts usually wants to be a short chain pointing at something longer."},{question:"Can I split the same text for Instagram instead?",answer:'Instagram does not chain, it just gives you 2,200 characters in one caption, so splitting is the wrong tool there. Use the character counter to check the caption fits and to see where the "... more" fold lands.'}],relatedToolSlugs:["thread-splitter","twitter-thread-maker","threads-character-counter","instagram-character-counter"]},"social-media-fonts-generator":{slug:"social-media-fonts-generator",family:"fonts-generator",platform:null,datePublished:N,lastUpdated:N,label:"Social media fonts generator",metaTitle:"Fonts Generator for Social Media: 23 Copy Paste Styles",metaDescription:"Free font generator for social media. Turn your text into bold, italic, script, small caps and 19 more styles that paste into any bio or caption.",heroEyebrow:"Free tool",heroTitle:"Font Generator for Social Media",heroLead:"Type once and get 23 styles back, from bold and italic to script, fraktur and small caps, each one ready to paste into a bio or a caption that has no formatting controls at all.",intro:["Instagram, TikTok and X give you a plain text box. There is no bold button, no italic toggle, and no way to make one word stand out. What people paste in 